---
import { Image, Picture } from 'astro:assets';
import EnvelopeSimpleIcon from '@phosphor-icons/core/assets/regular/envelope-simple.svg';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import CopyEmailButton from '../ui/CopyEmailButton.astro';
import Gallery from '../ui/Gallery.astro';

import instagramIcon from '../../assets/icons/skill-icons/instagram.svg';
import whispLogo from '../../assets/images/logos/whisp.svg';

import { languages } from '../../data/languages';
import { photos } from '../../data/photos';
import { site } from '../../data/site';
import { summaryText } from '../../data/text';

const notices = [
  { angle: -80, color: '#fa7e1e' },
  { angle: -45, color: '#d62976' },
  { angle: -10, color: '#962fbf' },
];
const scatter = ['hover:-rotate-6', 'hover:rotate-6', 'hover:rotate-3', 'hover:-rotate-3'];
const coreLanguages = languages.filter((language) => !language.optional).length;
const galleryWidth = 768;
const photoWidth = 1500;
const slides = photos.map((photo) => ({ ...photo, ratio: photo.src.width / photo.src.height }));
---

<section id="summary" class="@container pb-14 sm:pb-20">
  <div class="grid gap-(--gap)" data-bento>
    <Card class="@container col-span-2 flex flex-col justify-between p-(--pad-wide)" data-enter style="--delay: 3">
      <span class="text-(length:--title) leading-[calc(4/3)] tracking-tight">{summaryText.languages}</span>
      <div class="flex justify-between" style={`--core: ${coreLanguages}; --all: ${languages.length}`} data-languages>
        {
          languages.map((language) => (
            <button
              type="button"
              aria-label={language.name}
              data-language={language.name}
              data-optional={language.optional || undefined}
              class="press rounded-xl transition-[translate,scale,rotate,filter] duration-500 ease-spring"
            >
              <Image src={language.icon} alt="" width={64} height={64} loading="eager" data-language-icon />
            </button>
          ))
        }
      </div>
    </Card>

    <Card class="group @container relative isolate flex flex-col justify-between p-(--pad)" data-enter style="--delay: 4">
      <EnvelopeSimpleIcon
        class="absolute -right-(--envelope-offset) -bottom-(--envelope-offset) -z-10 hidden size-(--envelope) -rotate-14 text-zinc-200 transition duration-700 ease-spring group-hover:-translate-y-4 group-hover:-rotate-3 group-hover:duration-450 group-hover:ease-bounce group-has-data-copied:translate-x-24 group-has-data-copied:duration-700 group-has-data-copied:ease-spring group-has-data-copied:-translate-y-24 group-has-data-copied:rotate-14 group-has-data-copied:opacity-0 @min-[8rem]:block dark:text-zinc-800"
        aria-hidden="true"
      />
      <span class="text-[length:min(var(--title),20cqi)] leading-[calc(4/3)] tracking-tight">{summaryText.question}</span>
      <CopyEmailButton email={site.email} />
    </Card>

    <Card
      href={summaryText.whisp.href}
      target="_blank"
      rel="noopener noreferrer"
      class="relative shine press [--press-scale:0.97]"
      data-tilt
      data-enter
      style="--delay: 5"
    >
      <Image src={whispLogo} alt={summaryText.whisp.alt} loading="eager" class="size-full object-cover" />
    </Card>

    <Card class="@container col-span-2 flex gap-(--space) p-(--pad-wide)" data-enter data-follow-card style="--delay: 6">
      <div class="flex min-w-0 grow flex-col items-start justify-between">
        <div class="flex max-w-full items-center gap-2 @min-[21rem]:gap-3">
          <button
            type="button"
            aria-label={site.socials.instagram.name}
            class="shrink-0 press rounded-xl transition-transform duration-500 ease-spring hover:scale-115 hover:-rotate-12"
            data-instagram-logo
          >
            <span class="relative block" data-instagram-icon>
              <Image src={instagramIcon} alt="" loading="eager" width={40} height={40} class="size-(--logo)" />
              <span aria-hidden="true" class="pointer-events-none absolute -top-0.5 -right-0.5">
                {notices.map(({ angle, color }) => (
                  <span
                    class="absolute top-0 left-0 h-[3px] w-2.5 origin-left rounded-full opacity-0"
                    style={`rotate: ${angle}deg; background: ${color}`}
                    data-notice
                  />
                ))}
              </span>
            </span>
          </button>
          <span class="min-w-0 truncate text-(length:--handle) text-muted @max-[15rem]:hidden">{site.socials.instagram.label}</span>
        </div>
        <Button
          href={site.socials.instagram.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={summaryText.followLabel}
          data-follow
        >
          {summaryText.follow}
        </Button>
      </div>

      <div class="grid aspect-square h-full shrink-0 grid-cols-2 grid-rows-2 gap-(--photo-gap)">
        {
          photos.map((photo, i) => (
            <button
              type="button"
              aria-label={summaryText.openPhoto(photo.alt)}
              class:list={[
                'relative press overflow-hidden rounded-(--photo-radius) transition duration-500 ease-spring hover:z-10 hover:scale-110 hover:shadow-lg',
                scatter[i],
              ]}
              data-gallery-open="photos"
            >
              <Picture
                src={photo.src}
                alt={photo.alt}
                formats={['avif']}
                fallbackFormat="webp"
                width={256}
                widths={[96, 160, 256]}
                sizes="(min-width: 528px) 72px, calc(17vw - 12px)"
                loading="eager"
                pictureAttributes={{ class: 'contents' }}
                class="size-full object-cover"
              />
            </button>
          ))
        }
      </div>
    </Card>
  </div>
</section>

<Gallery name="photos" label={summaryText.photos} count={slides.length} class="max-w-3xl">
  {
    slides.map(({ src, alt, ratio }) => (
      <div class="grid place-items-center">
        <Picture
          src={src}
          alt={alt}
          formats={['avif']}
          fallbackFormat="webp"
          width={photoWidth}
          widths={[480, 720, 960, 1200, photoWidth]}
          sizes={`min(${galleryWidth}px, 100vw - 2rem, ${ratio * 75}vh, ${ratio} * (100vh - 7rem))`}
          pictureAttributes={{ class: 'contents' }}
          class="rounded-2xl"
          style={{ width: `min(100%, ${ratio} * min(75svh, 100svh - var(--gallery-space)))` }}
          data-gallery-item
        />
      </div>
    ))
  }
</Gallery>

<style>
  @property --cell {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  [data-bento] {
    --cols: 2;
    --gap: 1rem;
    --cell: calc((100cqi - (var(--cols) - 1) * var(--gap)) / var(--cols));
    --pad: clamp(1rem, 13%, 1.75rem);
    --pad-wide: clamp(1rem, 13% / 2.1, 1.75rem);
    --space: clamp(1rem, var(--cell) * 0.13, 1.75rem);
    --title: clamp(1.125rem, var(--cell) * 0.115, 1.75rem);
    --logo: clamp(1.5rem, var(--cell) * 0.165, 2.5rem);
    --handle: clamp(0.75rem, var(--cell) * 0.095, 1rem);
    --photo-gap: calc(var(--cell) * 0.055);
    --photo-radius: calc(var(--cell) * 0.06);
    --envelope: calc(var(--cell) * 0.53);
    --envelope-offset: calc(var(--cell) * 0.095);
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-auto-rows: var(--cell);
  }

  @container (width >= 30rem) {
    [data-bento] {
      --cols: 3;
      --gap: 1.25rem;
    }
  }

  [data-languages] {
    --icons: var(--all);
  }

  @container (width < 17.5rem) {
    [data-languages] {
      --icons: var(--core);
    }

    [data-optional] {
      display: none;
    }
  }

  [data-language-icon] {
    width: calc(100cqi / (var(--icons) + (var(--icons) - 1) * 0.35));
    height: auto;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-language]:hover {
      translate: 0 -0.6rem;
      scale: 1.25;
      filter: drop-shadow(0 0.5rem 0.5rem rgb(0 0 0 / 0.15));
    }

    [data-language]:hover:active {
      scale: 1.1;
    }

    [data-language]:has(+ [data-language]:hover) {
      translate: 0 -0.25rem;
      scale: 1.1;
      rotate: -6deg;
    }

    [data-language]:hover + [data-language] {
      translate: 0 -0.25rem;
      scale: 1.1;
      rotate: 6deg;
    }
  }
</style>

<script>
  import { found } from '../../scripts/eggs';
  import { playOnce, reducedMotion, smooth, spring } from '../../scripts/motion';

  const maxTilt = 10;

  document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || reducedMotion.matches) return;
      const { left, top, width, height } = card.getBoundingClientRect();
      const x = (event.clientX - left) / width;
      const y = (event.clientY - top) / height;
      card.style.setProperty('--tilt-x', `${(0.5 - y) * maxTilt}deg`);
      card.style.setProperty('--tilt-y', `${(x - 0.5) * maxTilt}deg`);
    });

    card.addEventListener('pointerleave', () => {
      card.style.removeProperty('--tilt-x');
      card.style.removeProperty('--tilt-y');
    });
  });

  const languageButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-language]')];
  const secret = ['C#', 'C++', 'PHP', 'Java'];
  const comboStep = 900;
  let progress = 0;
  let lastPress = 0;
  let lastTrick = -1;

  const tricks = (): [PropertyIndexedKeyframes, KeyframeAnimationOptions][] => [
    [
      {
        transform: ['scale(1) rotate(0deg)', 'scale(1.35) rotate(-15deg)', 'scale(1) rotate(360deg)'],
        offset: [0, 0.3, 1],
      },
      { duration: 600, easing: spring() },
    ],
    [
      { transform: ['perspective(300px) rotateY(0deg)', 'perspective(300px) rotateY(360deg)'] },
      { duration: 700, easing: spring() },
    ],
    [
      { transform: ['perspective(300px) rotateX(0deg)', 'perspective(300px) rotateX(360deg)'] },
      { duration: 700, easing: spring() },
    ],
    [
      {
        transform: [
          'translateY(0) scale(1, 1)',
          'translateY(-1.25rem) scale(0.9, 1.15)',
          'translateY(0) scale(1.2, 0.8)',
          'translateY(0) scale(1, 1)',
        ],
        offset: [0, 0.4, 0.75, 1],
      },
      { duration: 650, easing: 'ease-out' },
    ],
    [
      { transform: ['rotate(0deg)', 'rotate(-18deg)', 'rotate(14deg)', 'rotate(-10deg)', 'rotate(6deg)', 'rotate(0deg)'] },
      { duration: 700, easing: 'ease-in-out' },
    ],
    [
      { transform: ['scale(1)', 'scale(1.6)', 'scale(0.85)', 'scale(1.15)', 'scale(1)'] },
      { duration: 600, easing: 'ease-out' },
    ],
  ];

  const iconOf = (button: HTMLButtonElement) => button.querySelector<HTMLElement>('[data-language-icon]')!;

  const shown = () => languageButtons.filter((button) => button.offsetParent !== null);

  const ripple = (source: HTMLButtonElement) => {
    const row = shown();
    const origin = row.indexOf(source);
    row.forEach((button, index) => {
      if (button === source) return;
      iconOf(button).animate(
        { translate: ['0 0', '0 -0.5rem', '0 0'] },
        { duration: 450, delay: Math.abs(index - origin) * 70, easing: spring(), composite: 'add' },
      );
    });
  };

  const celebrate = () => {
    found('language-combo');
    if (reducedMotion.matches) return;
    shown().forEach((button, index) =>
      iconOf(button).animate(
        {
          transform: ['scale(1) rotate(0deg)', 'scale(1.3) rotate(180deg)', 'scale(1) rotate(360deg)'],
          offset: [0, 0.5, 1],
        },
        { duration: 800, delay: index * 90, easing: spring() },
      ),
    );
  };

  languageButtons.forEach((button) => {
    let playing: Animation | undefined;

    button.addEventListener('click', () => {
      const now = performance.now();
      if (now - lastPress > comboStep) progress = 0;
      lastPress = now;

      if (button.dataset.language === secret[progress]) {
        progress += 1;
      } else {
        progress = button.dataset.language === secret[0] ? 1 : 0;
      }

      if (progress === secret.length) {
        progress = 0;
        celebrate();
        return;
      }

      if (reducedMotion.matches || playing?.playState === 'running') return;

      const list = tricks();
      let next = Math.floor(Math.random() * list.length);
      if (next === lastTrick) next = (next + 1) % list.length;
      lastTrick = next;

      const [keyframes, options] = list[next];
      playing = iconOf(button).animate(keyframes, options);
      ripple(button);
    });
  });

  const sway = 'cubic-bezier(0.37, 0, 0.63, 1)';
  const pose = (y: number, angle: number, x: number, yScale = x) =>
    `translateY(${y}rem) rotate(${angle}deg) scale(${x}, ${yScale})`;

  const excited: PropertyIndexedKeyframes = {
    transform: [
      pose(0, 0, 1),
      pose(0.08, 0, 1.12, 0.88),
      pose(-0.7, -14, 0.94, 1.1),
      pose(0, 0, 1.1, 0.92),
      pose(-0.35, 12, 1.08),
      pose(0, -8, 1.04),
      pose(0, 5, 1.03),
      pose(0, -2, 1.01),
      pose(0, 0, 1),
    ],
    offset: [0, 0.1, 0.3, 0.45, 0.58, 0.7, 0.81, 0.91, 1],
    easing: sway,
  };

  const notice: PropertyIndexedKeyframes = {
    transform: ['translateX(0.1rem) scaleX(0)', 'translateX(0.25rem) scaleX(1)', 'translateX(0.6rem) scaleX(0.3)'],
    opacity: [0, 1, 0],
    offset: [0, 0.35, 1],
  };

  document.querySelectorAll<HTMLElement>('[data-follow-card]').forEach((card) => {
    const follow = card.querySelector<HTMLElement>('[data-follow]');
    const icon = card.querySelector<HTMLElement>('[data-instagram-icon]');
    if (!follow || !icon) return;
    const lines = [...icon.querySelectorAll<HTMLElement>('[data-notice]')];

    const cheer = () => {
      if (!playOnce(icon, excited, { duration: 1300 })) return;
      lines.forEach((line, i) => line.animate(notice, { duration: 550, delay: 60 + i * 50, easing: smooth() }));
    };

    follow.addEventListener('pointerenter', ({ pointerType }) => {
      if (pointerType === 'mouse') cheer();
    });
    follow.addEventListener('focus', () => {
      if (follow.matches(':focus-visible')) cheer();
    });
  });

  document.querySelectorAll<HTMLElement>('[data-instagram-logo]').forEach((logo) => {
    logo.addEventListener('click', () =>
      playOnce(
        logo,
        {
          transform: ['rotate(0deg) scale(1)', 'rotate(-20deg) scale(1.3)', 'rotate(360deg) scale(1)'],
          offset: [0, 0.3, 1],
        },
        { duration: 700, easing: spring() },
      ),
    );
  });
</script>