---
import { Image } from 'astro:assets';
import { site } from '../../data/site';
---

<section id="hero" class="flex flex-col gap-3 py-14 sm:py-20">
  <button
    type="button"
    aria-label="Flip profile picture"
    class="w-fit rounded-full"
    data-avatar
    data-enter
  >
    <Image
      src={site.avatar}
      alt={site.name}
      width={100}
      height={100}
      widths={[200, 300, 400]}
      sizes="100px"
      quality={90}
      priority
      class="rounded-full shadow-sm ring-1 ring-line transition-transform duration-500 ease-spring hover:scale-110 hover:-rotate-6"
    />
  </button>
  <h1 class="mt-2 text-4xl font-bold tracking-tight" data-enter="text" style="--delay: 1">{site.name}</h1>
  <p class="max-w-[500px] text-muted" data-enter="text" style="--delay: 2">
    I'm Gideon, a software engineering student from the Netherlands, studying at Hanze
    University of Applied Sciences in Groningen. Alongside my studies, I work as a PHP
    developer at Dotsimpel, where I apply my skills in the real world.
  </p>
</section>

<script>
  import { reducedMotion } from '../../scripts/motion';

  const avatar = document.querySelector<HTMLButtonElement>('[data-avatar]')!;
  let flip: Animation | undefined;

  avatar.addEventListener('click', () => {
    if (reducedMotion.matches || flip?.playState === 'running') return;
    flip = avatar.animate(
      { transform: ['perspective(400px) rotateY(0deg)', 'perspective(400px) rotateY(360deg)'] },
      { duration: 900, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' },
    );
  });
</script>