---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...attributes } = Astro.props;

const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'size-full overflow-hidden rounded-3xl border border-line bg-surface text-sm shadow-xs',
    href && 'transition-colors duration-300 hover:border-zinc-300 dark:hover:border-zinc-700',
    className,
  ]}
  {...attributes}
>
  <slot />
</Tag>