---
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'a'>, 'type'>;

const { href, class: className, ...attributes } = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : 'button'}
  class:list={['w-fit rounded-full bg-zinc-200 px-4 py-2 text-center dark:bg-zinc-800', className]}
  {...attributes}
>
  <slot />
</Tag>