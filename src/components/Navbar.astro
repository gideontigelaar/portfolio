---
import HouseIcon from '@phosphor-icons/core/assets/regular/house.svg';
import ThemeToggle from './ThemeToggle.astro';
import Zzz from './easter-eggs/Zzz.astro';
import { aboutText, contactText, navText, projectsText } from '../data/text';

const links = [
  { href: '/#about', label: aboutText.title },
  { href: '/#projects', label: projectsText.title },
  { href: '/#contact', label: contactText.title },
];
---

<div aria-hidden="true" class="pointer-events-none sticky top-0 z-40 -mb-16 h-16" data-nav-glass>
  <div class="absolute inset-x-0 top-full h-6" data-nav-fade></div>
</div>
<header class="sticky top-0 z-50">
  <nav class="mx-auto flex max-w-[700px] items-center justify-between px-2 py-3 min-[360px]:px-4 sm:px-1">
    <a href="/#home" aria-label={navText.home} data-home class="relative flex nav-item items-center p-2">
      <HouseIcon class="size-6 origin-bottom" aria-hidden="true" />
      <Zzz place="nav" class="-top-0.5 left-3/4" />
    </a>
    <ul class="relative isolate flex items-center gap-0.5 min-[340px]:gap-1" data-nav>
      <li
        aria-hidden="true"
        class="absolute top-0 left-0 -z-10 rounded-full bg-zinc-200/70 opacity-0 transition-[translate,width,opacity] duration-500 ease-spring dark:bg-zinc-800"
        data-nav-pill
      >
      </li>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-item px-1.5 py-1.5 text-sm aria-[current=true]:text-zinc-950 min-[340px]:px-2 min-[340px]:text-base min-[360px]:px-3 dark:aria-[current=true]:text-zinc-50"
              data-nav-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  [data-nav-glass] {
    --nav-tint: color-mix(in oklab, var(--color-zinc-50) var(--nav-opacity, 90%), transparent);
    background-color: var(--nav-tint);
    -webkit-backdrop-filter: var(--nav-blur, blur(16px) saturate(1.5));
    backdrop-filter: var(--nav-blur, blur(16px) saturate(1.5));
  }

  :global(.dark) [data-nav-glass] {
    --nav-tint: color-mix(in oklab, var(--color-zinc-950) var(--nav-opacity, 90%), transparent);
  }

  [data-nav-fade] {
    background-image: linear-gradient(var(--nav-tint), transparent);
  }

  @media (prefers-reduced-transparency: reduce) {
    [data-nav-glass] {
      --nav-opacity: 100%;
      --nav-blur: none;
    }
  }

  @supports (-moz-appearance: none) or (-webkit-touch-callout: none) {
    [data-nav-glass] {
      --nav-opacity: 100%;
      --nav-blur: none;
    }
  }
</style>

<script>
  import { reducedMotion } from '../scripts/motion';

  interface Box {
    width: number;
    height: number;
    left: number;
    top: number;
  }

  const home = document.querySelector<HTMLAnchorElement>('[data-home]')!;
  const list = document.querySelector<HTMLElement>('[data-nav]')!;
  const pill = list.querySelector<HTMLElement>('[data-nav-pill]')!;
  const links = [...list.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const footer = document.querySelector('footer');
  const sections = new Map(
    links.flatMap((link) => {
      const section = document.getElementById(link.hash.slice(1));
      return section ? [[link, section] as const] : [];
    }),
  );
  const boxes = new Map<HTMLAnchorElement, Box>();
  const visible = new Set<Element>();
  const releaseDistance = 4;
  let active: HTMLAnchorElement | undefined;
  let pinned = false;
  let atBottom = false;
  let settledAt = 0;
  let settleTimer = 0;
  let pendingSettle: (() => void) | undefined;

  const draw = () => {
    const box = active && boxes.get(active);
    pill.style.opacity = box ? '1' : '0';
    if (!box) return;
    pill.style.width = `${box.width}px`;
    pill.style.height = `${box.height}px`;
    pill.style.translate = `${box.left}px ${box.top}px`;
  };

  const setActive = (link?: HTMLAnchorElement) => {
    if (link === active) return;
    active = link;
    links.forEach((item) => {
      if (item === link) {
        item.setAttribute('aria-current', 'true');
      } else {
        item.removeAttribute('aria-current');
      }
    });
    draw();
  };

  const sync = () => {
    if (pinned) return;
    setActive(atBottom ? links.at(-1) : [...sections].find(([, section]) => visible.has(section))?.[0]);
  };

  const release = () => {
    if (Math.abs(window.scrollY - settledAt) < releaseDistance) return;
    window.removeEventListener('scroll', release);
    pinned = false;
    sync();
  };

  new ResizeObserver(() => {
    links.forEach((link) =>
      boxes.set(link, { width: link.offsetWidth, height: link.offsetHeight, left: link.offsetLeft, top: link.offsetTop }),
    );
    draw();
  }).observe(list);

  if (sections.size) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach(({ target, isIntersecting }) => {
          if (isIntersecting) {
            visible.add(target);
          } else {
            visible.delete(target);
          }
        });
        sync();
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => spy.observe(section));

    if (footer) {
      new IntersectionObserver(
        ([entry]) => {
          atBottom = entry.isIntersecting;
          sync();
        },
        { rootMargin: '0px 0px 4px 0px', threshold: 1 },
      ).observe(footer);
    }

    links.forEach((link) =>
      link.addEventListener('click', () => {
        window.removeEventListener('scroll', release);
        window.clearTimeout(settleTimer);
        if (pendingSettle) window.removeEventListener('scrollend', pendingSettle);
        pinned = true;
        setActive(link);

        const settle = () => {
          window.clearTimeout(settleTimer);
          window.removeEventListener('scrollend', settle);
          pendingSettle = undefined;
          if (!pinned || active !== link) return;
          settledAt = window.scrollY;
          window.addEventListener('scroll', release, { passive: true });
        };
        pendingSettle = settle;
        window.addEventListener('scrollend', settle);
        settleTimer = window.setTimeout(settle, 1200);

        if (reducedMotion.matches) return;
        link.setAttribute('data-pressing', '');
        pill.animate({ scale: [1, 0.85, 1.06, 1] }, { duration: 450, easing: 'ease-out' });
        window.setTimeout(() => link.removeAttribute('data-pressing'), 450);
      }),
    );
  }

  home.addEventListener('click', () => {
    if (reducedMotion.matches) return;
    home.setAttribute('data-pressing', '');
    home.firstElementChild?.animate(
      {
        transform: [
          'translateY(0) scale(1)',
          'translateY(0) scale(1.2, 0.75)',
          'translateY(-8px) scale(0.9, 1.15)',
          'translateY(0) scale(1.1, 0.9)',
          'translateY(0) scale(1)',
        ],
        offset: [0, 0.15, 0.45, 0.75, 1],
      },
      { duration: 650, easing: 'ease-out' },
    );
    window.setTimeout(() => home.removeAttribute('data-pressing'), 650);
  });
</script>