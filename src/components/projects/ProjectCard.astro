---
import ProjectScreenshot from './ProjectScreenshot.astro';
import type { Project } from '../../data/projects';

type Props = Project;

const { title, year, description, screenshot, screenshotDark } = Astro.props;
---

<button
  type="button"
  class="group -mx-3 grid grid-cols-3 items-center gap-4 interactive-row rounded-3xl p-3 text-left sm:gap-5"
  data-gallery-open="projects"
>
  <span class="col-span-3 overflow-hidden rounded-2xl border border-line shadow-xs sm:col-span-1">
    <ProjectScreenshot
      title={title}
      screenshot={screenshot}
      screenshotDark={screenshotDark}
      alt=""
      widths={[320, 430, 640, 860]}
      sizes="(min-width: 640px) 215px, calc(100vw - 48px)"
      class="aspect-[16/10] w-full object-cover object-top transition-transform duration-500 ease-smooth group-hover:scale-105"
    />
  </span>
  <span class="col-span-3 flex flex-col gap-1 sm:col-span-2">
    <span class="flex items-baseline gap-2 text-lg font-semibold tracking-tight">
      <span class="underline-grow">{title}</span>
      <span class="text-sm font-medium text-muted tabular-nums">{year}</span>
    </span>
    <span class="line-clamp-3 min-h-[3lh] text-muted">{description}</span>
  </span>
</button>