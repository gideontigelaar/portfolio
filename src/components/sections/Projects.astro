---
import Gallery from '../Gallery.astro';
import ProjectCard from '../ProjectCard.astro';
import ProjectDetail from '../ProjectDetail.astro';
import { projects } from '../../data/projects';
---

<section id="projects" class="py-14 sm:py-20">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" data-reveal>Projects</h2>
  <p class="mb-6 text-muted" data-reveal style="--delay: 1">Here are some of the projects I've worked on.</p>

  <div class="grid grid-cols-1 gap-6 sm:gap-2">
    {
      projects.map((project, i) => (
        <div data-reveal style={`--delay: ${i + 2}`}>
          <ProjectCard {...project} />
        </div>
      ))
    }
  </div>

  <Gallery name="projects" label="Projects" count={projects.length} crossfade class="max-w-lg">
    {projects.map((project) => <ProjectDetail {...project} />)}
  </Gallery>
</section>

<script>
  import { reducedMotion, spring } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('#projects [data-tech]').forEach((list) => {
    const items = [...list.children] as HTMLElement[];
    const badges = items.map((item) => item.firstElementChild as HTMLElement);

    items.forEach((item, index) => {
      item.addEventListener('click', () => {
        if (reducedMotion.matches) return;
        badges.forEach((other, otherIndex) => {
          const source = otherIndex === index;
          other.animate(
            { transform: ['translateY(0)', source ? 'translateY(-0.75rem)' : 'translateY(-0.5rem)', 'translateY(0)'] },
            { duration: 450, delay: Math.abs(otherIndex - index) * 70, easing: spring },
          );
        });
      });
    });
  });
</script>