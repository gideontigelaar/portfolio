---
import { Image } from 'astro:assets';
import type { ExperienceEntry } from '../../data/experience';

type Props = ExperienceEntry & { gallery: string };

const { title, organization, period, logo, logoAlt, gallery } = Astro.props;
---

<button
  type="button"
  class="group -mx-3 flex items-center gap-3 interactive-row rounded-2xl px-3 py-2 text-left"
  data-gallery-open={gallery}
>
  <Image
    src={logo}
    alt={logoAlt}
    width={48}
    height={48}
    loading="eager"
    data-spin
    class="shrink-0 rounded-full bg-white ring-1 ring-line"
  />
  <span class="flex w-full flex-col">
    <span class="w-fit underline-grow">{title}</span>
    <span class="flex items-baseline justify-between gap-2 text-muted">
      <span>{organization}</span>
      <span class="text-sm tabular-nums">{period}</span>
    </span>
  </span>
</button>