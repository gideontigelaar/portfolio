---
import CaretLeftIcon from '@phosphor-icons/core/assets/regular/caret-left.svg';
import CaretRightIcon from '@phosphor-icons/core/assets/regular/caret-right.svg';
import XIcon from '@phosphor-icons/core/assets/regular/x.svg';

interface Props {
  name: string;
  label: string;
  count: number;
  crossfade?: boolean;
  class?: string;
}

const { name, label, count, crossfade = false, class: className } = Astro.props;

const navigation = [
  { icon: CaretLeftIcon, label: 'Previous', direction: -1, position: '-left-16', nudge: 'group-hover:-translate-x-0.5' },
  { icon: CaretRightIcon, label: 'Next', direction: 1, position: '-right-16', nudge: 'group-hover:translate-x-0.5' },
];
---

<dialog
  id={`${name}-gallery`}
  aria-label={label}
  tabindex="-1"
  class="isolate m-0 size-full max-h-none max-w-none flex-col items-center justify-center-safe gap-5 overflow-y-auto overscroll-contain bg-transparent p-4 pb-[calc(6rem+env(safe-area-inset-bottom))] text-zinc-950 outline-none backdrop:bg-transparent open:flex sm:pb-4 dark:text-zinc-50"
  data-gallery={name}
  data-crossfade={crossfade || undefined}
>
  <div class="fixed inset-0 -z-10 bg-zinc-950/50 backdrop-blur-sm" data-gallery-backdrop data-gallery-fade></div>
  <button
    type="button"
    aria-label="Close"
    class="group fixed right-0 bottom-[max(1rem,env(safe-area-inset-bottom))] left-0 z-10 mx-auto grid size-12 touch-manipulation place-items-center rounded-full bg-white/15 text-white shadow-lg backdrop-blur-md transition-colors sm:top-4 sm:right-4 sm:bottom-auto sm:left-auto sm:mx-0 sm:size-10 sm:bg-white/10 sm:shadow-none sm:hover:bg-white/20"
    data-gallery-close
    data-gallery-fade
    data-press
  >
    <XIcon class="size-5 transition-transform duration-300 ease-spring group-hover:rotate-90" aria-hidden="true" />
  </button>
  <div class:list={['relative w-full shrink-0', className]}>
    <div
      class:list={[
        'flex w-full snap-x snap-mandatory [scrollbar-width:none] gap-6 overflow-x-auto overscroll-x-contain *:w-full *:shrink-0 *:snap-center',
        count > 1 && 'cursor-grab active:cursor-grabbing',
      ]}
      data-gallery-track
    >
      <slot />
    </div>
    {
      count > 1 &&
        navigation.map(({ icon: Icon, label, direction, position, nudge }) => (
          <button
            type="button"
            aria-label={label}
            class:list={[
              'group absolute top-1/2 z-10 hidden size-11 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white backdrop-blur-md transition-colors hover:bg-white/20 lg:pointer-fine:grid',
              position,
            ]}
            data-gallery-shift={direction}
            data-gallery-fade
            data-press
          >
            <Icon class:list={['size-5 transition-transform duration-300 ease-spring', nudge]} aria-hidden="true" />
          </button>
        ))
    }
  </div>
  {
    count > 1 && (
      <div class="flex gap-2" data-gallery-dots data-gallery-fade>
        {Array.from({ length: count }, (_, i) => (
          <button
            type="button"
            aria-label={`Show ${i + 1} of ${count}`}
            class="h-2 w-2 rounded-full bg-white/40 transition-all duration-300 hover:bg-white/70 aria-[current=true]:w-6 aria-[current=true]:bg-white"
          />
        ))}
      </div>
    )
  }
</dialog>

<script>
  import { reducedMotion } from '../scripts/motion';

  const radius = (element: Element) =>
    parseFloat(getComputedStyle(element).borderTopLeftRadius) || 0;

  const isVisible = ({ width, top, bottom }: DOMRect) =>
    width > 0 && bottom > 0 && top < window.innerHeight;

  document.querySelectorAll<HTMLDialogElement>('dialog[data-gallery]').forEach((dialog) => {
    const track = dialog.querySelector<HTMLElement>('[data-gallery-track]')!;
    const slides = [...track.children] as HTMLElement[];
    const items = [...track.querySelectorAll<HTMLElement>('[data-gallery-item]')];
    const dots = [...dialog.querySelectorAll<HTMLButtonElement>('[data-gallery-dots] button')];
    const fades = [...dialog.querySelectorAll<HTMLElement>('[data-gallery-fade]')];
    const triggers = [
      ...document.querySelectorAll<HTMLElement>(`[data-gallery-open="${dialog.dataset.gallery}"]`),
    ];
    const crossfade = dialog.hasAttribute('data-crossfade');
    let index = 0;
    let busy = false;
    let dragged = false;

    const dismisses = (target: Element) =>
      target === dialog ||
      target === track ||
      target.hasAttribute('data-gallery-backdrop') ||
      !!target.closest('[data-gallery-close]') ||
      (target.parentElement === track && !target.hasAttribute('data-gallery-item'));

    const slideWidth = () =>
      slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : track.clientWidth;

    const select = (next: number) => {
      index = next;
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === next)));
    };

    const go = (next: number, behavior: ScrollBehavior = 'smooth') => {
      track.scrollTo({ left: Math.max(0, Math.min(next, slides.length - 1)) * slideWidth(), behavior });
    };

    const animate = async (opening: boolean) => {
      busy = true;
      const item = items[index];
      const trigger = triggers[index];
      const source = trigger.getBoundingClientRect();
      const target = item.getBoundingClientRect();
      const options: KeyframeAnimationOptions = {
        duration: reducedMotion.matches ? 150 : opening ? 550 : 450,
        easing: opening ? 'cubic-bezier(0.32, 0.72, 0, 1)' : 'cubic-bezier(1, 0, 0.68, 0.28)',
        direction: opening ? 'normal' : 'reverse',
        fill: 'both',
      };
      const animations = fades.map((element) => element.animate({ opacity: [0, 1] }, options));
      let ghost: HTMLElement | undefined;

      if (reducedMotion.matches || !isVisible(source) || !target.width) {
        animations.push(item.animate({ opacity: [0, 1], scale: [0.95, 1] }, options));
      } else {
        const scale = Math.max(source.width / target.width, source.height / target.height);
        const x = source.x + source.width / 2 - target.x - target.width / 2;
        const y = source.y + source.height / 2 - target.y - target.height / 2;
        const insetX = (target.width - source.width / scale) / 2;
        const insetY = (target.height - source.height / scale) / 2;

        ghost = item.cloneNode(true) as HTMLElement;
        Object.assign(ghost.style, {
          position: 'fixed',
          top: `${target.top}px`,
          left: `${target.left}px`,
          width: `${target.width}px`,
          height: `${target.height}px`,
          margin: '0',
          pointerEvents: 'none',
        });
        dialog.append(ghost);
        item.style.visibility = 'hidden';
        if (!crossfade) trigger.style.visibility = 'hidden';

        animations.push(
          ghost.animate(
            {
              transform: [`translate(${x}px, ${y}px) scale(${scale})`, 'none'],
              clipPath: [
                `inset(${insetY}px ${insetX}px round ${radius(trigger) / scale}px)`,
                `inset(0px 0px round ${radius(item)}px)`,
              ],
              opacity: crossfade ? [0, 1] : [1, 1],
            },
            options,
          ),
        );
      }

      await Promise.all(animations.map((animation) => animation.finished));
      if (!opening) dialog.close();
      ghost?.remove();
      item.style.visibility = trigger.style.visibility = '';
      animations.forEach((animation) => animation.cancel());
      busy = false;
    };

    const open = (next: number) => {
      if (busy || dialog.open) return;
      items.forEach((item, i) => {
        const thumbnail = triggers[i]?.querySelector('img');
        if (item instanceof HTMLImageElement && thumbnail) {
          item.style.background = `center / cover url("${thumbnail.currentSrc}")`;
        }
      });
      dialog.showModal();
      dialog.focus();
      go(next, 'instant');
      select(next);
      animate(true);
    };

    const shift = (direction: number) => go((index + direction + slides.length) % slides.length);

    const close = () => {
      if (!busy && dialog.open) animate(false);
    };

    triggers.forEach((trigger, i) => trigger.addEventListener('click', () => open(i)));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    dialog.querySelectorAll<HTMLButtonElement>('[data-gallery-shift]').forEach((button) => {
      button.addEventListener('click', () => shift(Number(button.dataset.galleryShift)));
    });

    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    dialog.addEventListener('click', (event) => {
      if (dismisses(event.target as Element)) close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      shift(event.key === 'ArrowRight' ? 1 : -1);
    });

    let wheelLocked = false;
    let wheelTimeout = 0;

    dialog.addEventListener(
      'wheel',
      (event) => {
        const vertical = Math.abs(event.deltaY) > Math.abs(event.deltaX);
        if (!vertical || slides.length < 2 || dialog.scrollHeight > dialog.clientHeight) return;
        event.preventDefault();
        clearTimeout(wheelTimeout);
        wheelTimeout = window.setTimeout(() => (wheelLocked = false), 200);
        if (wheelLocked || Math.abs(event.deltaY) < 4) return;
        wheelLocked = true;
        go(index + Math.sign(event.deltaY));
      },
      { passive: false },
    );

    track.addEventListener(
      'scroll',
      () => {
        const next = Math.round(track.scrollLeft / slideWidth());
        if (next !== index) select(next);
      },
      { passive: true },
    );

    track.addEventListener('dragstart', (event) => event.preventDefault());

    dialog.addEventListener(
      'click',
      (event) => {
        if (!dragged) return;
        dragged = false;
        event.stopImmediatePropagation();
        event.preventDefault();
      },
      true,
    );

    track.addEventListener('pointerdown', (event) => {
      dragged = false;
      if (event.pointerType !== 'mouse' || event.button !== 0 || slides.length < 2) return;
      event.preventDefault();

      const start = { x: event.clientX, left: track.scrollLeft, index };
      let delta = 0;

      const move = (moveEvent: PointerEvent) => {
        delta = moveEvent.clientX - start.x;
        if (!dragged && Math.abs(delta) > 5) {
          dragged = true;
          track.style.scrollSnapType = 'none';
        }
        if (dragged) track.scrollLeft = start.left - delta;
      };

      const settle = () => track.style.removeProperty('scroll-snap-type');

      window.addEventListener('pointermove', move);
      window.addEventListener(
        'pointerup',
        () => {
          window.removeEventListener('pointermove', move);
          if (!dragged) return;
          if ('onscrollend' in window) {
            track.addEventListener('scrollend', settle, { once: true });
          } else {
            setTimeout(settle, 500);
          }
          go(Math.abs(delta) > 60 ? start.index - Math.sign(delta) : start.index);
        },
        { once: true },
      );
    });
  });
</script>

<style>
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-gallery-track] > :global(*) {
        animation-name: swipe;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: view(inline);
      }
    }
  }

  @keyframes swipe {
    0%,
    100% {
      opacity: 0.4;
      scale: 0.92;
    }

    50% {
      opacity: 1;
      scale: 1;
    }
  }
</style>