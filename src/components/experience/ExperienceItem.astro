---
import { Image } from 'astro:assets';
import type { ExperienceEntry } from '../../data/experience';

type Props = ExperienceEntry & { gallery: string };

const { title, organization, period, logo, gallery } = Astro.props;
---

<button
  type="button"
  class="group -mx-3 flex interactive-row items-center gap-3 rounded-3xl p-3 text-left"
  data-gallery-open={gallery}
>
  <Image
    src={logo}
    alt=""
    width={48}
    height={48}
    loading="eager"
    data-spin
    class="shrink-0 rounded-full bg-white ring-1 ring-line transition-[scale,rotate] duration-500 ease-spring group-hocus:scale-110 group-hocus:-rotate-6"
  />
  <span class="flex w-full flex-col">
    <span class="w-fit underline-grow">{title}</span>
    <span class="flex items-baseline justify-between gap-2 text-muted">
      <span>{organization}</span>
      <span class="text-sm whitespace-nowrap tabular-nums">{period}</span>
    </span>
  </span>
</button>