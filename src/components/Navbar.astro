---
import HouseIcon from '@phosphor-icons/core/assets/regular/house.svg';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/#about', label: 'About' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#contact', label: 'Contact' },
];
---

<nav
  class="sticky top-0 z-50 -mx-3 flex justify-between bg-zinc-50/80 px-1 py-3 backdrop-blur-md dark:bg-zinc-950/80"
>
  <a
    href="/#home"
    aria-label="Home"
    data-home
    class="flex items-center nav-item p-2"
  >
    <HouseIcon class="size-6 origin-bottom" aria-hidden="true" />
  </a>
  <ul class="flex items-center gap-1">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-item px-3 py-1.5"
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  <ThemeToggle />
</nav>

<script>
  import { reducedMotion } from '../scripts/motion';

  const home = document.querySelector<HTMLAnchorElement>('[data-home]')!;

  home.addEventListener('click', () => {
    if (reducedMotion.matches) return;
    home.firstElementChild?.animate(
      {
        transform: [
          'translateY(0) scale(1)',
          'translateY(0) scale(1.2, 0.75)',
          'translateY(-8px) scale(0.9, 1.15)',
          'translateY(0) scale(1.1, 0.9)',
          'translateY(0) scale(1)',
        ],
        offset: [0, 0.15, 0.45, 0.75, 1],
      },
      { duration: 650, easing: 'ease-out' },
    );
  });
</script>