<script>
  import { confetti } from '../../scripts/confetti';
  import { found } from '../../scripts/eggs';
  import { onSequence } from '../../scripts/keys';
  import { reducedMotion } from '../../scripts/motion';
  import { toast } from '../../scripts/toast';

  const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];

  onSequence(code, 5000, () => {
    const on = document.documentElement.toggleAttribute('data-retro');
    if (!reducedMotion.matches) confetti();
    toast(on ? 'Retro mode on' : 'Retro mode off');
    found('konami');
  });
</script>

<style is:global>
  html[data-retro] {
    --crt-line: rgb(0 0 0 / 0.1);
    --crt-rim: rgb(0 0 0 / 0.22);
    --crt-band: rgb(0 0 0 / 0.06);
  }

  html.dark[data-retro] {
    --crt-line: rgb(255 255 255 / 0.06);
    --crt-rim: rgb(59 130 246 / 0.22);
    --crt-band: rgb(255 255 255 / 0.06);
  }

  html[data-retro] body {
    letter-spacing: 0.03em;
    text-shadow:
      0.5px 0 rgb(244 63 94 / 0.35),
      -0.5px 0 rgb(6 182 212 / 0.35);
  }

  html.dark[data-retro] body {
    text-shadow:
      0.5px 0 rgb(244 63 94 / 0.4),
      -0.5px 0 rgb(6 182 212 / 0.4),
      0 0 8px rgb(96 165 250 / 0.35);
  }

  html[data-retro] body::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, transparent 0 2px, var(--crt-line) 2px 4px);
    box-shadow: inset 0 0 120px var(--crt-rim);
    animation: crt-on 0.5s ease-out backwards;
  }

  html[data-retro] body::before {
    content: '';
    position: fixed;
    inset: 0 0 auto;
    height: 28vh;
    z-index: 79;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--crt-band) 50%, transparent);
    translate: 0 -100%;
  }

  html[data-retro] [data-cursor] > * {
    border-radius: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    html[data-retro] body::before {
      animation: crt-roll 7s linear infinite;
    }
  }

  @keyframes crt-on {
    from {
      opacity: 0;
    }
  }

  @keyframes crt-roll {
    to {
      translate: 0 100vh;
    }
  }
</style>