---
import GithubLogoIcon from '@phosphor-icons/core/assets/regular/github-logo.svg';
import InstagramLogoIcon from '@phosphor-icons/core/assets/regular/instagram-logo.svg';
import LinkedinLogoIcon from '@phosphor-icons/core/assets/regular/linkedin-logo.svg';
import ArrowUpRightIcon from '@phosphor-icons/core/assets/regular/arrow-up-right.svg';
import { site } from '../../data/site';

const contacts = [
  { icon: GithubLogoIcon, ...site.socials.github },
  { icon: LinkedinLogoIcon, ...site.socials.linkedin },
  { icon: InstagramLogoIcon, ...site.socials.instagram },
];
---

<section id="contact" class="py-14 sm:py-20">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" data-reveal>Contact</h2>
  <p class="mb-6 text-muted" data-reveal style="--delay: 1">Feel free to reach out to me on any of the following platforms:</p>

  <ul class="flex flex-col gap-3" data-reveal style="--delay: 2">
    {
      contacts.map(({ icon: Icon, label, url }) => (
        <li>
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex touch-manipulation items-center gap-3"
            data-press="inner"
          >
            <span class="grid size-9 place-items-center rounded-xl border border-line bg-surface shadow-xs transition duration-300 ease-spring [--press:var(--color-zinc-950)] group-hover:scale-110 group-hover:-rotate-6 group-hover:border-zinc-950 group-hover:bg-zinc-950 group-hover:text-white group-data-launching:animate-[launch_var(--launch-duration)_ease-out] group-data-launching:duration-75 group-data-launching:border-zinc-950 group-data-launching:bg-zinc-950 group-data-launching:text-white dark:[--press:var(--color-white)] dark:group-hover:border-white dark:group-hover:bg-white dark:group-hover:text-zinc-950 dark:group-data-launching:border-white dark:group-data-launching:bg-white dark:group-data-launching:text-zinc-950">
              <Icon class="size-4" aria-hidden="true" />
            </span>
            <span class="underline-grow text-blue-600 group-hover:translate-x-1 group-data-launching:translate-x-1 dark:text-blue-400">
              {label}
            </span>
            <ArrowUpRightIcon
              class="size-4 -translate-x-1 text-blue-600 opacity-0 transition duration-300 ease-smooth group-hover:translate-x-1 group-hover:opacity-100 group-data-launching:translate-x-2 group-data-launching:opacity-100 dark:text-blue-400"
              aria-hidden="true"
            />
          </a>
        </li>
      ))
    }
  </ul>
</section>