---
import { Image } from 'astro:assets';
import ArrowSquareOutIcon from '@phosphor-icons/core/assets/regular/arrow-square-out.svg';
import ArrowsOutSimpleIcon from '@phosphor-icons/core/assets/regular/arrows-out-simple.svg';
import CodeIcon from '@phosphor-icons/core/assets/regular/code.svg';
import CursorClickIcon from '@phosphor-icons/core/assets/regular/cursor-click.svg';
import HouseIcon from '@phosphor-icons/core/assets/regular/house.svg';
import ImageIcon from '@phosphor-icons/core/assets/regular/image.svg';
import LinkSimpleIcon from '@phosphor-icons/core/assets/regular/link-simple.svg';
import LinkedinLogoIcon from '@phosphor-icons/core/assets/fill/linkedin-logo-fill.svg';
import MoonIcon from '@phosphor-icons/core/assets/regular/moon.svg';
import SunIcon from '@phosphor-icons/core/assets/regular/sun.svg';
import TextTIcon from '@phosphor-icons/core/assets/regular/text-t.svg';
import Button from './ui/Button.astro';
import { site } from '../data/site';

const item =
  'group flex w-full shrink-0 items-center gap-3 rounded-xl px-3 py-2 text-left transition-colors focus:bg-zinc-100 active:bg-zinc-100 pointer-coarse:py-3 forced-colors:focus:outline-2 dark:focus:bg-zinc-800 dark:active:bg-zinc-800';
const icon = 'size-4 shrink-0 transition-transform duration-300 ease-spring';
const separator = 'my-1 shrink-0 border-t border-line';
const newTabMotion = 'group-focus:translate-x-0.5 group-focus:-translate-y-0.5 group-focus:scale-125';

const actions = [
  { name: 'open', label: 'Open', icon: ArrowsOutSimpleIcon, motion: 'group-focus:scale-125' },
  { name: 'interact', label: 'Interact', icon: CursorClickIcon, motion: 'group-focus:-translate-y-0.5 group-focus:scale-125' },
  { name: 'link-tab', label: 'Open link in new tab', icon: ArrowSquareOutIcon, motion: newTabMotion },
  { name: 'copy-link', label: 'Copy link', icon: LinkSimpleIcon, motion: 'group-focus:-rotate-12 group-focus:scale-125' },
  { name: 'image-tab', label: 'Open image in new tab', icon: ArrowSquareOutIcon, motion: newTabMotion },
  { name: 'copy-image', label: 'Copy image', icon: ImageIcon, motion: 'group-focus:-rotate-6 group-focus:scale-125' },
  { name: 'copy-text', label: 'Copy text', icon: TextTIcon, motion: 'group-focus:-translate-y-0.5 group-focus:scale-125' },
];
---

<div
  role="menu"
  aria-label="Quick menu"
  tabindex="-1"
  inert
  class="invisible fixed top-0 left-0 z-60 flex max-h-[calc(100dvh-1rem)] w-56 scale-95 flex-col overflow-y-auto overscroll-contain rounded-2xl border border-line bg-surface p-1.5 text-sm opacity-0 shadow-lg blur-[5px] transition-[opacity,filter,scale,visibility] duration-200 outline-none data-open:visible data-open:scale-100 data-open:opacity-100 data-open:blur-none data-open:transition-[opacity,filter,scale] data-open:duration-300 data-open:ease-spring motion-reduce:scale-100 motion-reduce:blur-none"
  data-context-menu
>
  <a
    role="menuitem"
    tabindex="-1"
    href={site.socials.linkedin.url}
    target="_blank"
    rel="noopener noreferrer"
    class={item}
  >
    <span class="relative shrink-0 transition-transform duration-300 ease-spring group-focus:scale-110 group-focus:-rotate-6">
      <Image src={site.avatar} alt="" width={32} height={32} densities={[1, 2, 3]} format="webp" class="rounded-full" />
      <LinkedinLogoIcon
        class="absolute -right-1 -bottom-1 size-4 rounded-sm bg-white text-[#0a66c2]"
        aria-hidden="true"
      />
    </span>
    <span class="flex flex-col leading-tight">
      <span class="font-semibold">{site.name}</span>
      <span class="text-xs text-muted">View on LinkedIn</span>
    </span>
  </a>
  <div role="separator" class={separator}></div>
  <div role="group" class="flex shrink-0 flex-col" data-context-group hidden>
    {
      actions.map(({ name, label, icon: Icon, motion }) => (
        <button type="button" role="menuitem" tabindex="-1" class={item} data-action={name} hidden>
          <Icon class:list={[icon, motion]} aria-hidden="true" />
          {label}
        </button>
      ))
    }
  </div>
  <div role="separator" class={separator} data-context-group hidden></div>
  <a role="menuitem" tabindex="-1" href="/#home" class={item} data-context-home>
    <HouseIcon class:list={[icon, 'group-focus:-translate-y-0.5 group-focus:scale-125']} aria-hidden="true" />
    Home
  </a>
  <button type="button" role="menuitem" tabindex="-1" class={item} data-context-theme>
    <MoonIcon class:list={[icon, 'group-focus:-rotate-12 group-focus:scale-125 dark:hidden']} aria-hidden="true" />
    <SunIcon class:list={[icon, 'hidden group-focus:rotate-45 group-focus:scale-125 dark:block']} aria-hidden="true" />
    <span class="dark:hidden">Dark mode</span>
    <span class="hidden dark:inline">Light mode</span>
  </button>
  <div role="separator" class={separator} data-secret hidden></div>
  <button type="button" role="menuitem" tabindex="-1" class={item} data-secret data-context-source hidden>
    <CodeIcon class:list={[icon, 'group-focus:scale-125']} aria-hidden="true" />
    Secret menu
  </button>
</div>

<dialog
  aria-labelledby="about-site-title"
  class="group m-auto w-[min(100%-2rem,24rem)] overflow-visible bg-transparent p-0 text-zinc-950 opacity-0 transition-[opacity,display,overlay] transition-discrete duration-300 backdrop:bg-zinc-950/50 backdrop:opacity-0 backdrop:backdrop-blur-sm backdrop:transition-[opacity,display,overlay] backdrop:transition-discrete backdrop:duration-300 backdrop:backdrop-webkit open:opacity-100 open:backdrop:opacity-100 motion-reduce:transition-none dark:text-zinc-50 starting:open:opacity-0 starting:open:backdrop:opacity-0"
  data-about
>
  <div
    class="scale-95 rounded-3xl border border-line bg-surface p-6 shadow-xl transition-[scale] duration-300 ease-spring group-open:scale-100 motion-reduce:transition-none starting:group-open:scale-95"
  >
    <h2 id="about-site-title" class="text-xl font-bold tracking-tight">About this site</h2>
    <p class="mt-2 text-sm text-muted">
      Built with Astro and Tailwind CSS. No trackers or ads, just a lot of small details.
    </p>
    <p class="mt-4 rounded-2xl bg-zinc-100 px-4 py-3 text-sm dark:bg-zinc-800">
      Easter eggs found: <strong data-about-count>0</strong>
    </p>
    <div class="mt-6 flex gap-2">
      <Button href={`${site.socials.github.url}/portfolio`} target="_blank" rel="noopener noreferrer" variant="primary">
        View on GitHub
      </Button>
      <Button data-about-close>Close</Button>
    </div>
  </div>
</dialog>

<script>
  import '../scripts/context-menu';
</script>