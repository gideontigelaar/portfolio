---
import MoonIcon from '@phosphor-icons/core/assets/regular/moon.svg';
import SunIcon from '@phosphor-icons/core/assets/regular/sun.svg';
---

<button
  type="button"
  class="grid nav-item p-2 *:col-start-1 *:row-start-1 *:size-6 *:transition *:duration-500 *:ease-spring"
  aria-label="Toggle theme"
  data-theme-toggle
>
  <SunIcon class="dark:scale-0 dark:-rotate-90 dark:opacity-0" aria-hidden="true" />
  <MoonIcon class="scale-0 rotate-90 opacity-0 dark:scale-100 dark:rotate-0 dark:opacity-100" aria-hidden="true" />
</button>

<script>
  import { toggleTheme } from '../scripts/theme';

  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;

  const toggleFromButton = () => {
    const { x, y, width, height } = toggle.getBoundingClientRect();
    toggleTheme(x + width / 2, y + height / 2);
  };

  toggle.addEventListener('click', toggleFromButton);

  document.addEventListener('click', ({ target, clientX, clientY }) => {
    if (target !== document.documentElement) return;
    const { left, right, top, bottom } = toggle.getBoundingClientRect();
    if (clientX >= left && clientX <= right && clientY >= top && clientY <= bottom) toggleFromButton();
  });
</script>