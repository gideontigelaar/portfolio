---
import GithubLogoIcon from '@phosphor-icons/core/assets/regular/github-logo.svg';
import InstagramLogoIcon from '@phosphor-icons/core/assets/regular/instagram-logo.svg';
import LinkedinLogoIcon from '@phosphor-icons/core/assets/regular/linkedin-logo.svg';
import { site } from '../../data/site';

const contacts = [
  { icon: GithubLogoIcon, ...site.socials.github },
  { icon: LinkedinLogoIcon, ...site.socials.linkedin },
  { icon: InstagramLogoIcon, ...site.socials.instagram },
];
---

<section id="contact" class="py-20">
  <h2 class="mb-2 text-2xl font-semibold">Contact</h2>
  <p class="mb-6 opacity-75">Feel free to reach out to me on any of the following platforms:</p>

  <div class="flex flex-col gap-4">
    {
      contacts.map(({ icon: Icon, label, url }) => (
        <div class="flex items-center gap-2">
          <Icon class="size-4" aria-hidden="true" />
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-600 dark:text-blue-400"
          >
            {label}
          </a>
        </div>
      ))
    }
  </div>
</section>