---
import { Picture } from 'astro:assets';
import type { Project } from '../../data/projects';

type Props = Pick<Project, 'title' | 'screenshot' | 'screenshotDark'> & {
  widths: number[];
  sizes: string;
  alt?: string;
  class?: string;
};

const { title, screenshot, screenshotDark, widths, sizes, alt = `${title} screenshot`, class: className } = Astro.props;

const screenshots = [
  { src: screenshot, visibility: screenshotDark ? 'block dark:hidden' : undefined },
  ...(screenshotDark ? [{ src: screenshotDark, visibility: 'hidden dark:block' }] : []),
];
---

{
  screenshots.map(({ src, visibility }) => (
    <Picture
      src={src}
      alt={alt}
      formats={['avif']}
      fallbackFormat="webp"
      width={Math.max(...widths)}
      widths={widths}
      sizes={sizes}
      pictureAttributes={{ class: 'contents' }}
      class:list={[className, visibility]}
    />
  ))
}