---
import ExperienceItem from '../ExperienceItem.astro';
import { education, work } from '../../data/experience';
---

<section id="about" class="py-14 sm:py-20">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight">About</h2>

  <div class="grid grid-cols-2 gap-12 sm:gap-6">
    <p class="col-span-2 text-muted sm:col-span-1">
      I'm Gideon, a software engineering student from the Netherlands, studying at Hanze
      University of Applied Sciences in Groningen. Alongside my studies, I work as a PHP
      developer at Dotsimpel, where I apply my skills in the real world. I'm also actively
      exploring the world of software development and engineering through personal projects and
      by connecting with new people.
      <br /><br />
      My interest in programming started at age 11, when I began creating simple games in Unity.
      A few years later, I started building my own Discord bot. That's when it clicked! I knew I
      wanted to turn my passion into a career.
    </p>

    <div class="col-span-2 flex flex-col gap-3 sm:col-span-1">
      <h3 class="text-xl font-semibold tracking-tight">Work Experience</h3>
      {work.map((entry) => <ExperienceItem {...entry} />)}

      <h3 class="mt-4 text-xl font-semibold tracking-tight">Education</h3>
      {education.map((entry) => <ExperienceItem {...entry} />)}
    </div>
  </div>
</section>