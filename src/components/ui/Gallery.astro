---
import CaretLeftIcon from '@phosphor-icons/core/assets/regular/caret-left.svg';
import CaretRightIcon from '@phosphor-icons/core/assets/regular/caret-right.svg';
import XIcon from '@phosphor-icons/core/assets/regular/x.svg';
import Dots from './Dots.astro';
import { uiText } from '../../data/text';

interface Props {
  name: string;
  label: string;
  count: number;
  width: string;
  crossfade?: boolean;
}

const { name, label, count, width, crossfade = false } = Astro.props;

const pillButton =
  'group relative grid size-9 press place-items-center rounded-full bg-white/15 text-white transition-[background-color,scale] duration-300 ease-spring after:absolute after:-inset-1 hover:bg-white/25 lg:pointer-fine:hidden';

const navigation = [
  { icon: CaretLeftIcon, label: uiText.previous, direction: -1, position: '-left-16', nudge: 'group-hover:-translate-x-0.5' },
  { icon: CaretRightIcon, label: uiText.next, direction: 1, position: '-right-16', nudge: 'group-hover:translate-x-0.5' },
];
---

<dialog
  id={`${name}-gallery`}
  aria-label={label}
  tabindex="-1"
  class="isolate m-0 size-full max-h-none max-w-none flex-col items-center justify-center gap-5 overflow-y-auto overscroll-contain bg-transparent px-(--gallery-pad) pt-4 pb-[calc(5.25rem+env(safe-area-inset-bottom))] text-zinc-950 outline-none [--gallery-pad:1rem] [--gallery-space:calc(6.25rem+env(safe-area-inset-bottom))] backdrop:bg-transparent open:flex sm:pb-4 sm:[--gallery-pad:4.5rem] sm:[--gallery-space:3.75rem] dark:text-zinc-50"
  style={`--gallery-width: ${width}`}
  data-gallery={name}
  data-crossfade={crossfade || undefined}
>
  <div class="fixed inset-x-0 -inset-y-1/2 -z-10 bg-zinc-950/50 backdrop-blur-sm" data-gallery-backdrop data-gallery-fade></div>
  <div class="@container w-full shrink-0">
    <div class="relative mx-auto max-w-(--gallery-width)">
      <div class="pointer-events-none -mx-(--gallery-side) -my-1 overflow-clip py-1 lg:pointer-fine:-m-1 lg:pointer-fine:p-1">
        <div
          class:list={[
            'pointer-events-auto flex w-full snap-x snap-mandatory gap-(--gallery-gap) overflow-x-auto overscroll-x-contain px-(--gallery-side) [scrollbar-width:none] *:max-h-[calc(100svh-var(--gallery-space))] *:w-full *:shrink-0 *:snap-center *:snap-always lg:pointer-fine:gap-6 lg:pointer-fine:px-0 [&::-webkit-scrollbar]:hidden',
            count > 1 && 'cursor-grab active:cursor-grabbing',
          ]}
          data-gallery-track
          data-swipe-fade
        >
          <slot />
        </div>
      </div>
      {
        count > 1 &&
          navigation.map(({ icon: Icon, label, direction, position, nudge }) => (
            <button
              type="button"
              aria-label={label}
              class:list={[
                'group absolute top-1/2 z-10 hidden size-11 -translate-y-1/2 press place-items-center rounded-full bg-white/10 text-white backdrop-blur-md transition-[color,background-color,scale] duration-300 ease-spring hover:bg-white/20 lg:pointer-fine:grid',
                position,
              ]}
              data-gallery-shift={direction}
              data-gallery-fade
            >
              <Icon class:list={['size-5 transition-transform duration-300 ease-spring', nudge]} aria-hidden="true" />
            </button>
          ))
      }
    </div>
  </div>
  <div
    class="fixed inset-x-0 bottom-[max(1rem,env(safe-area-inset-bottom))] z-10 mx-auto flex w-fit items-center gap-3 rounded-full bg-zinc-900/70 p-1 shadow-lg ring-1 ring-white/10 backdrop-blur-md backdrop-saturate-150 sm:contents"
    data-gallery-fade="rise"
  >
    {
      count > 1 && (
        <div class="flex items-center gap-3 sm:gap-4" data-gallery-fade>
          <button
            type="button"
            aria-label={navigation[0].label}
            class={pillButton}
            data-gallery-shift={navigation[0].direction}
          >
            <CaretLeftIcon class:list={['size-4.5 transition-transform duration-300 ease-spring', navigation[0].nudge]} aria-hidden="true" />
          </button>
          <Dots count={count} label={uiText.show} tone="light" />
          <button
            type="button"
            aria-label={navigation[1].label}
            class={pillButton}
            data-gallery-shift={navigation[1].direction}
          >
            <CaretRightIcon class:list={['size-4.5 transition-transform duration-300 ease-spring', navigation[1].nudge]} aria-hidden="true" />
          </button>
        </div>
      )
    }
    {count > 1 && <p class="sr-only" role="status" data-gallery-status></p>}
    <button
      type="button"
      aria-label={uiText.close}
      class="group relative grid size-9 press place-items-center rounded-full bg-white/15 text-white transition-[color,background-color,scale] duration-300 ease-spring after:absolute after:-inset-1 hover:bg-white/25 sm:fixed sm:top-4 sm:right-4 sm:size-10 sm:bg-white/10 sm:backdrop-blur-md sm:hover:bg-white/20"
      data-gallery-close
      data-gallery-fade
    >
      <XIcon class="size-4.5 transition-transform duration-300 ease-spring group-hover:rotate-90 sm:size-5" aria-hidden="true" />
    </button>
  </div>
</dialog>

<script>
  import '../../scripts/gallery';
</script>

<style>
  @property --fade-top {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  @property --fade-bottom {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  [data-gallery] {
    --gallery-side: calc(var(--gallery-pad) + max(0px, (100cqi - var(--gallery-width)) / 2));
    --gallery-gap: max(1.5rem, var(--gallery-side));
  }

  :global([data-gallery-scroll]) {
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 var(--fade-top),
      #000 calc(100% - var(--fade-bottom)),
      transparent
    );
  }

  @supports (animation-timeline: scroll()) {
    :global([data-gallery-scroll]) {
      animation-name: scroll-fade;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(self);
    }
  }

  @keyframes scroll-fade {
    0% {
      --fade-top: 0px;
      --fade-bottom: 2rem;
    }

    12% {
      --fade-top: 2rem;
    }

    88% {
      --fade-bottom: 2rem;
    }

    100% {
      --fade-top: 2rem;
      --fade-bottom: 0px;
    }
  }
</style>