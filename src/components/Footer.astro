---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="flex items-center justify-center py-6 text-sm text-muted">
  <span>
    &copy;{' '}
    <span class="relative inline-block" data-year-scope>
      <button type="button" class="touch-manipulation tabular-nums" data-year>{year}</button>
      <span
        class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 rounded-full px-2.5 py-1 text-xs font-semibold whitespace-nowrap opacity-0"
        role="status"
        data-year-toast
      ></span>
    </span>
    {' '}- {site.name}
  </span>
</footer>

<script>
  import { found } from '../scripts/eggs';
  import { reducedMotion, smooth, spring } from '../scripts/motion';

  const footer = document.querySelector<HTMLElement>('footer')!;
  const scope = footer.querySelector<HTMLElement>('[data-year-scope]')!;
  const year = scope.querySelector<HTMLElement>('[data-year]')!;
  const toast = scope.querySelector<HTMLElement>('[data-year-toast]')!;
  const original = Number(year.textContent);
  const cooldown = 5000;
  const grace = 400;
  const settle = 250;
  const resetDuration = 1500;
  const milestones = new Map<number, [string, number]>([
    [10, ['Warming up', 0]],
    [25, ['On fire!', 0.23]],
    [50, ['Unstoppable', 0.38]],
    [100, ['Legendary', 0.56]],
    [250, ['Maybe take a break?', 0.75]],
  ]);
  const visited = new Set<number>();
  let heat = 0;
  let streak = 0;
  let last = 0;
  let lastClick = 0;
  let frame = 0;
  let settleTimer = 0;
  let rewind = 0;
  let resetting = false;

  const easeInOut = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);
  const easeOut = (t: number) => 1 - (1 - t) ** 3;

  const stopRewind = () => {
    cancelAnimationFrame(rewind);
    rewind = 0;
  };

  const startRewind = (duration?: number, ease = easeInOut) => {
    stopRewind();
    const from = Number(year.textContent);
    if (from === original) {
      resetting = false;
      return;
    }
    const length = reducedMotion.matches ? 1 : (duration ?? Math.min(1800, 500 + (from - original) * 12));
    const start = performance.now();

    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / length);
      year.textContent = String(Math.round(from - (from - original) * ease(t)));
      if (t < 1) {
        rewind = requestAnimationFrame(tick);
        return;
      }
      rewind = 0;
      resetting = false;
      if (reducedMotion.matches) return;
      year.animate({ scale: ['1.1', '1'] }, { duration: 450, easing: smooth });
    };
    rewind = requestAnimationFrame(tick);
  };

  const cool = (time: number) => {
    if (time - lastClick > grace) heat = Math.max(0, heat - (time - last) / cooldown);
    last = time;
    scope.style.setProperty('--heat', heat.toFixed(3));
    year.toggleAttribute('data-hot', heat > 0.5);
    if (!heat) {
      streak = 0;
      settleTimer = window.setTimeout(() => {
        if (!rewind) startRewind();
      }, settle);
    }
    frame = heat > 0 ? requestAnimationFrame(cool) : 0;
  };

  const pop = (message: string, intensity = 0) => {
    toast.textContent = message;
    toast.style.setProperty('--intensity', String(intensity));
    toast.toggleAttribute('data-shake', intensity > 0);
    toast
      .getAnimations()
      .filter((animation) => !(animation instanceof CSSAnimation))
      .forEach((animation) => animation.cancel());
    const animation = toast.animate(
      reducedMotion.matches
        ? { opacity: [0, 1, 1, 0] }
        : {
            opacity: [0, 1, 1, 0],
            transform: [
              'translateY(0) scale(0.6)',
              'translateY(-1.5rem) scale(1)',
              'translateY(-1.75rem) scale(1)',
              'translateY(-2.25rem) scale(0.95)',
            ],
            offset: [0, 0.2, 0.75, 1],
          },
      { duration: 2400, easing: smooth },
    );
    animation.onfinish = () => toast.removeAttribute('data-shake');
  };

  const glitch = () => {
    if (reducedMotion.matches) return;
    footer.setAttribute('data-glitch', '');
    window.setTimeout(() => footer.removeAttribute('data-glitch'), 600);
  };

  const timeMachine = () => {
    resetting = true;
    heat = 0;
    streak = 0;
    scope.style.setProperty('--heat', '0');
    year.removeAttribute('data-hot');
    pop('Time machine reset');
    startRewind(resetDuration, easeOut);
  };

  const travel = (value: number) => {
    if (value === 9999) {
      timeMachine();
      return true;
    }
    if (visited.has(value) || (value !== 2100 && value !== 3000)) return false;
    visited.add(value);
    found('time-travel');
    if (value === 3000) {
      glitch();
      pop('Year 3000. Still coding PHP.');
    } else {
      pop('Welcome to the future');
    }
    return true;
  };

  year.addEventListener('click', () => {
    if (resetting) return;
    stopRewind();
    window.clearTimeout(settleTimer);
    const value = Number(year.textContent) + 1;
    year.textContent = String(value);
    heat = Math.min(1, heat + 0.07);
    lastClick = performance.now();
    streak += 1;
    const milestone = milestones.get(streak);
    if (!travel(value) && milestone) pop(`${streak}× ${milestone[0]}`, milestone[1]);
    year.animate(
      { translate: ['0 0.6em', '0 0'], opacity: [0, 1], filter: ['blur(3px)', 'blur(0)'] },
      { duration: 400, easing: spring },
    );
    if (!frame) {
      last = performance.now();
      frame = requestAnimationFrame(cool);
    }
  });

  window.setYear = (value: number) => {
    if (!Number.isFinite(value)) return 'Pass a number, for example setYear(2099)';
    const next = Math.round(value);
    stopRewind();
    window.clearTimeout(settleTimer);
    resetting = false;
    year.textContent = String(next);
    travel(next);
    return `Counter set to ${next}`;
  };
</script>

<style>
  [data-year-scope] {
    --heat: 0;
    --fire: color-mix(in oklab, #f97316, #dc2626 calc(max(var(--heat) * 2 - 1, 0) * 100%));
  }

  [data-year],
  [data-year-toast] {
    color: color-mix(in oklab, currentColor, var(--fire) calc(min(var(--heat) * 2, 1) * 100%));
  }

  [data-year] {
    text-shadow: 0 0 calc(var(--heat) * 12px) rgb(239 68 68 / calc(var(--heat) * 0.9));
  }

  :global(html[data-golden]) [data-year-scope] {
    color: #d97706;
  }

  :global(html.dark[data-golden]) [data-year-scope] {
    color: #fbbf24;
  }

  [data-year-toast] {
    background: color-mix(in oklab, currentColor 14%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, currentColor 30%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-year][data-hot] {
      animation: burn 0.12s linear infinite;
    }

    [data-year-toast][data-shake] {
      animation: rattle 0.1s linear infinite;
    }

    footer[data-glitch] > span {
      animation: glitch 0.6s steps(2) both;
    }
  }

  @keyframes glitch {
    0%,
    100% {
      translate: 0;
      text-shadow: none;
    }

    20% {
      translate: -3px 0;
      text-shadow:
        2px 0 #f43f5e,
        -2px 0 #06b6d4;
    }

    40% {
      translate: 3px 0;
      text-shadow:
        -3px 0 #f43f5e,
        3px 0 #06b6d4;
    }

    60% {
      translate: -2px 0;
      text-shadow:
        2px 1px #f43f5e,
        -2px -1px #06b6d4;
    }

    80% {
      translate: 2px 0;
      text-shadow:
        -1px 0 #f43f5e,
        1px 0 #06b6d4;
    }
  }

  @keyframes rattle {
    25% {
      translate: calc(-50% - var(--intensity) * 4px) 0;
      rotate: calc(var(--intensity) * -8deg);
    }

    75% {
      translate: calc(-50% + var(--intensity) * 4px) 0;
      rotate: calc(var(--intensity) * 8deg);
    }
  }

  @keyframes burn {
    25% {
      translate: calc(var(--heat) * -2px) calc(var(--heat) * 1px);
      rotate: calc(var(--heat) * -5deg);
    }

    75% {
      translate: calc(var(--heat) * 2px) calc(var(--heat) * -1px);
      rotate: calc(var(--heat) * 5deg);
    }
  }
</style>