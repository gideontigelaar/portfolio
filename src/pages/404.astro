---
import Button from '../components/ui/Button.astro';
import Layout from '../layouts/Layout.astro';
import { notFoundText } from '../data/text';
---

<Layout title={notFoundText.title} noindex>
  <section class="flex flex-col items-center gap-3 py-20 text-center">
    <h1 class="text-4xl font-bold tracking-tight">{notFoundText.heading}</h1>
    <p class="max-w-[500px] text-muted">{notFoundText.message}</p>
    <Button href="/" variant="primary" data-home-button>{notFoundText.home}</Button>
    <div class="mt-10 flex w-full flex-col items-center gap-3" data-game-wrap hidden>
      <div
        role="application"
        aria-label={notFoundText.instructions}
        aria-describedby="game-score"
        tabindex="0"
        class="group relative h-56 w-full max-w-md overflow-hidden rounded-3xl border-2 border-dashed border-zinc-950/30 dark:border-white/30"
        data-game
      >
        <span
          aria-hidden="true"
          class="absolute top-1/2 left-1/2 size-16 -translate-1/2 rounded-full border-2 border-dashed border-transparent transition-colors group-focus-visible:border-blue-500/40"
        ></span>
        <span
          aria-hidden="true"
          class="absolute top-0 left-0 grid size-8 place-items-center"
          data-game-dot
        >
          <span
            class="size-[calc(1.25rem_-_var(--caught,0)*0.1rem)] rounded-full border-2 border-zinc-950/45 transition-[width,height] duration-300 ease-spring dark:border-white/55"
            data-game-core
          ></span>
        </span>
      </div>
      <p id="game-score" class="text-sm text-muted" aria-live="polite" data-game-score>{notFoundText.prompt}</p>
    </div>
  </section>
</Layout>

<script>
  import { notFoundText } from '../data/text';
  import { found, isDesktop } from '../scripts/eggs';
  import { reducedMotion } from '../scripts/motion';

  if (isDesktop()) {
    const wrap = document.querySelector<HTMLElement>('[data-game-wrap]')!;
    wrap.hidden = false;

    const area = wrap.querySelector<HTMLElement>('[data-game]')!;
    const dot = area.querySelector<HTMLElement>('[data-game-dot]')!;
    const core = dot.querySelector<HTMLElement>('[data-game-core]')!;
    const score = wrap.querySelector<HTMLElement>('[data-game-score]')!;
    const home = document.querySelector<HTMLElement>('[data-home-button]');
    const goal = 5;
    const zone = 28;
    let caught = 0;
    let playing = false;
    let timer = 0;

    const speed = () => 900 - caught * 120;

    const shrink = () => {
      core.style.setProperty('--caught', String(caught));
    };

    const place = (x: number, y: number) => {
      dot.style.translate = `${x}px ${y}px`;
    };

    const center = () => ({
      x: (area.clientWidth - dot.offsetWidth) / 2,
      y: (area.clientHeight - dot.offsetHeight) / 2,
    });

    const move = () => {
      if (!playing) return;
      const middle = center();
      const duration = speed();
      const near = Math.random() < 0.3;
      const x = near ? middle.x + (Math.random() - 0.5) * 20 : Math.random() * middle.x * 2;
      const y = near ? middle.y + (Math.random() - 0.5) * 20 : Math.random() * middle.y * 2;
      dot.style.transitionDuration = `${duration}ms`;
      place(x, y);
      if (reducedMotion.matches) timer = window.setTimeout(move, duration);
    };

    const start = () => {
      if (playing || caught >= goal) return;
      playing = true;
      score.textContent = notFoundText.score(caught, goal);
      move();
    };

    const miss = () => {
      if (!playing || !caught) return;
      caught -= 1;
      shrink();
      score.textContent = notFoundText.missed(caught, goal);
      if (reducedMotion.matches) return;
      area.animate(
        { translate: ['0 0', '-4px 0', '4px 0', '-2px 0', '0 0'] },
        { duration: 250, easing: 'ease-out' },
      );
    };

    const win = () => {
      playing = false;
      window.clearTimeout(timer);
      score.textContent = notFoundText.win;
      found('catch-the-dot');
      if (reducedMotion.matches) return;
      home?.animate(
        { scale: [1, 1.1, 1], boxShadow: ['0 0 0 0 rgb(59 130 246 / 0.5)', '0 0 0 12px rgb(59 130 246 / 0)', 'none'] },
        { duration: 1000, iterations: 4, easing: 'ease-out', composite: 'add' },
      );
    };

    const catchDot = () => {
      if (!playing) return;
      caught += 1;
      shrink();
      if (!reducedMotion.matches) dot.animate({ scale: [1.8, 1] }, { duration: 300, easing: 'ease-out' });

      if (caught < goal) {
        score.textContent = notFoundText.score(caught, goal);
        window.clearTimeout(timer);
        move();
        return;
      }

      win();
    };

    window.winGame = () => {
      caught = goal;
      shrink();
      win();
      return notFoundText.won;
    };

    const middle = center();
    place(middle.x, middle.y);
    dot.style.transitionProperty = reducedMotion.matches ? 'none' : 'translate';
    dot.style.transitionTimingFunction = 'ease-in-out';

    dot.addEventListener('transitionend', (event) => {
      if (event.propertyName === 'translate') move();
    });

    area.addEventListener('pointerenter', start);
    area.addEventListener('focus', start);

    dot.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (!playing) {
        start();
        return;
      }
      catchDot();
    });

    area.addEventListener('pointerdown', () => {
      if (playing) {
        miss();
        return;
      }
      start();
    });

    area.addEventListener('keydown', (event) => {
      if (event.key !== ' ') return;
      event.preventDefault();
      if (!playing) {
        start();
        return;
      }
      const zoneRect = area.getBoundingClientRect();
      const dotRect = dot.getBoundingClientRect();
      const distance = Math.hypot(
        dotRect.left + dotRect.width / 2 - (zoneRect.left + zoneRect.width / 2),
        dotRect.top + dotRect.height / 2 - (zoneRect.top + zoneRect.height / 2),
      );
      if (distance <= zone) {
        catchDot();
      } else {
        miss();
      }
    });
  }
</script>