---
import { Image } from 'astro:assets';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import type { ExperienceEntry } from '../../data/experience';
import { aboutText } from '../../data/text';

type Props = ExperienceEntry;

const { title, organization, period, href, logo, logoAlt, details } = Astro.props;
---

<Card class="flex flex-col" data-gallery-item>
  <div class="flex min-h-0 grow flex-col items-start gap-4 overflow-y-auto overscroll-y-contain p-6 pb-0" data-gallery-scroll>
    <Image
      src={logo}
      alt={logoAlt}
      width={72}
      height={72}
      loading="eager"
      data-spin
      class="shrink-0 rounded-full bg-white ring-1 ring-line"
    />
    <div class="flex flex-col gap-2">
      <h3 class="text-xl font-semibold tracking-tight">{title}</h3>
      <div class="flex flex-wrap items-center gap-2">
        <Badge>{period}</Badge>
        <span class="text-muted">{organization}</span>
      </div>
    </div>
    <p class="text-muted">{details}</p>
  </div>
  <div class="shrink-0 p-6 pt-4">
    <Button href={href} target="_blank" rel="noopener noreferrer" aria-label={`${aboutText.visit}: ${organization}`}>
      {aboutText.visit}
    </Button>
  </div>
</Card>