---
import { Font } from 'astro:assets';
import '../styles/global.css';
import ContextMenu from '../components/ContextMenu.astro';
import Cursor from '../components/Cursor.astro';
import Console from '../components/easter-eggs/Console.astro';
import Disco from '../components/easter-eggs/Disco.astro';
import Konami from '../components/easter-eggs/Konami.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.name, description = site.description, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.href,
  description: site.description,
  jobTitle: site.jobTitle,
  sameAs: Object.values(site.socials).map(({ url }) => url),
};
---

<!doctype html>
<html lang="en" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl.href} />}
    <meta name="theme-color" content="#fafafa" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />}
    <Font cssVariable="--font-manrope" preload={[{ weight: 500 }, { weight: 700 }]} />
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (theme === 'dark' || (!theme && prefersDark)) {
          document.documentElement.classList.add('dark');
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#09090b');
        }
      })();
    </script>
  </head>
  <body
    id="home"
    class="bg-zinc-50 font-medium text-zinc-950 antialiased dark:bg-zinc-950 dark:text-zinc-50"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-100 focus:rounded-full focus:bg-zinc-900 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white dark:focus:bg-zinc-50 dark:focus:text-zinc-900"
    >
      Skip to content
    </a>
    <Navbar />
    <div class="mx-auto w-full max-w-[700px] px-6 sm:px-3">
      <main id="main" tabindex="-1" class="outline-none">
        <slot />
      </main>
      <Footer />
    </div>
    <ContextMenu />
    <Cursor />
    <Konami />
    <Disco />
    <Console />
    <script>
      import '../scripts/press';
      import '../scripts/reveal';
    </script>
  </body>
</html>