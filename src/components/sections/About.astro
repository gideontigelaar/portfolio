---
import ExperienceDetail from '../experience/ExperienceDetail.astro';
import ExperienceItem from '../experience/ExperienceItem.astro';
import Gallery from '../ui/Gallery.astro';
import { education, work } from '../../data/experience';
import { site } from '../../data/site';
---

<section id="about" class="py-14 sm:py-20">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" data-reveal>About</h2>

  <div class="grid grid-cols-2 gap-12 sm:gap-6">
    <p class="col-span-2 text-muted sm:col-span-1" data-reveal style="--delay: 1">
      {site.intro} I'm also actively exploring the world of software development and engineering
      through personal projects and by connecting with new people.
      <br /><br />
      My interest in programming started at age 11, when I began creating simple games in Unity.
      A few years later, I started building my own Discord bot. That's when it clicked! I knew I
      wanted to turn my passion into a career.
    </p>

    <div class="col-span-2 flex flex-col gap-3 sm:col-span-1" data-reveal style="--delay: 2">
      <h3 class="text-xl font-semibold tracking-tight">Work Experience</h3>
      {work.map((entry) => <ExperienceItem {...entry} gallery="work" />)}

      <h3 class="mt-4 text-xl font-semibold tracking-tight">Education</h3>
      {education.map((entry) => <ExperienceItem {...entry} gallery="education" />)}
    </div>
  </div>

  <Gallery name="work" label="Work experience" count={work.length} crossfade class="max-w-md">
    {work.map((entry) => <ExperienceDetail {...entry} />)}
  </Gallery>

  <Gallery name="education" label="Education" count={education.length} crossfade class="max-w-md">
    {education.map((entry) => <ExperienceDetail {...entry} />)}
  </Gallery>
</section>

<script>
  import { playOnce, spring } from '../../scripts/motion';

  const spin = (logo: HTMLElement) =>
    playOnce(
      logo,
      {
        transform: ['rotate(0deg) scale(1)', 'rotate(180deg) scale(1.15)', 'rotate(360deg) scale(1)'],
        offset: [0, 0.5, 1],
      },
      { duration: 700, easing: spring },
    );

  document.querySelectorAll<HTMLElement>('#about [data-gallery-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const logo = trigger.querySelector<HTMLElement>('[data-spin]');
      if (logo) spin(logo);
    });
  });

  document.querySelectorAll<HTMLElement>('#about [data-gallery-item] [data-spin]').forEach((logo) => {
    logo.addEventListener('click', () => spin(logo));
  });
</script>