---
import ExperienceDetail from '../experience/ExperienceDetail.astro';
import ExperienceList from '../experience/ExperienceList.astro';
import Gallery from '../ui/Gallery.astro';
import { education, work } from '../../data/experience';
import { aboutText } from '../../data/text';

const maxWorkOnPage = 2;
const maxEducationOnPage = 2;
---

<section id="about" class="py-14 sm:py-20">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" data-reveal>{aboutText.title}</h2>

  <div class="grid grid-cols-2 gap-12 sm:gap-6">
    <div class="col-span-2 flex flex-col gap-6 text-muted sm:col-span-1" data-reveal style="--delay: 1">
      {aboutText.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="col-span-2 flex flex-col gap-3 sm:col-span-1" data-reveal style="--delay: 2">
      <h3 class="text-xl font-semibold tracking-tight">{aboutText.work}</h3>
      <ExperienceList entries={work} gallery="work" label={aboutText.work.toLowerCase()} max={maxWorkOnPage} />

      <h3 class="mt-4 text-xl font-semibold tracking-tight">{aboutText.education}</h3>
      <ExperienceList
        entries={education}
        gallery="education"
        label={aboutText.education.toLowerCase()}
        max={maxEducationOnPage}
      />
    </div>
  </div>

  <Gallery name="work" label={aboutText.work} count={work.length} crossfade class="max-w-md">
    {work.map((entry) => <ExperienceDetail {...entry} />)}
  </Gallery>

  <Gallery name="education" label={aboutText.education} count={education.length} crossfade class="max-w-md">
    {education.map((entry) => <ExperienceDetail {...entry} />)}
  </Gallery>
</section>

<script>
  import { playOnce, spring } from '../../scripts/motion';

  const spin = (logo: HTMLElement) =>
    playOnce(
      logo,
      {
        transform: ['rotate(0deg) scale(1)', 'rotate(180deg) scale(1.15)', 'rotate(360deg) scale(1)'],
        offset: [0, 0.5, 1],
      },
      { duration: 700, easing: spring() },
    );

  document.querySelectorAll<HTMLElement>('#about [data-gallery-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const logo = trigger.querySelector<HTMLElement>('[data-spin]');
      if (logo) spin(logo);
    });
  });

  document.querySelectorAll<HTMLElement>('#about [data-gallery-item] [data-spin]').forEach((logo) => {
    logo.addEventListener('click', () => spin(logo));
  });
</script>