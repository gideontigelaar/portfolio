---
import Carousel from '../ui/Carousel.astro';
import Gallery from '../ui/Gallery.astro';
import ProjectCard from '../projects/ProjectCard.astro';
import ProjectDetail from '../projects/ProjectDetail.astro';
import { projects } from '../../data/projects';
import { projectsText } from '../../data/text';

const projectsPerPage = 3;
const projectsPerPageMobile = 2;
const firstPage = Math.max(projectsPerPage, projectsPerPageMobile);
---

<section id="projects" class="py-14 sm:py-20">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" data-reveal>{projectsText.title}</h2>
  <p class="mb-6 text-muted" data-reveal style="--delay: 1">{projectsText.intro}</p>

  <Carousel label={projectsText.title} count={projects.length} perPage={projectsPerPage} perPageMobile={projectsPerPageMobile}>
    {
      projects.map((project, i) => (
        <div>
          <div data-carousel-item data-reveal={i < firstPage || undefined} style={i < firstPage ? `--delay: ${i + 2}` : undefined}>
            <ProjectCard {...project} />
          </div>
        </div>
      ))
    }
  </Carousel>

  <Gallery name="projects" label={projectsText.title} count={projects.length} width="32rem" crossfade>
    {projects.map((project) => <ProjectDetail {...project} />)}
  </Gallery>
</section>