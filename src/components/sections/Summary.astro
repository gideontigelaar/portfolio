---
import { getImage, Image, Picture } from 'astro:assets';
import EnvelopeSimpleIcon from '@phosphor-icons/core/assets/regular/envelope-simple.svg';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import CopyEmailButton from '../ui/CopyEmailButton.astro';
import Gallery from '../ui/Gallery.astro';

import instagramIcon from '../../assets/icons/skill-icons/instagram.svg';
import whispLogo from '../../assets/images/logos/whisp.webp';

import { languages } from '../../data/languages';
import { photos } from '../../data/photos';
import { site } from '../../data/site';

const scatter = ['hover:-rotate-6', 'hover:rotate-6', 'hover:rotate-3', 'hover:-rotate-3'];
const galleryWidth = 768;
const photoWidth = 1500;
const slides = await Promise.all(
  photos.map(async (photo) => {
    const { attributes } = await getImage({ src: photo.src, width: photoWidth, format: 'webp' });
    return { ...photo, ratio: Number(attributes.width) / Number(attributes.height) };
  }),
);
---

<section
  id="summary"
  class="grid grid-cols-2 gap-4 pb-14 sm:grid-cols-3 sm:grid-rows-2 sm:gap-5 sm:pb-20"
>
  <Card
    class="col-span-2 flex flex-col justify-between gap-6 p-5 sm:px-7 sm:py-8"
    data-enter
    style="--delay: 3"
  >
    <span class="text-2xl tracking-tight">Languages I use</span>
    <div class="flex justify-between">
      {
        languages.map((language) => (
          <button
            type="button"
            aria-label={language.name}
            data-language={language.name}
            class:list={[
              'rounded-xl transition-transform duration-500 ease-spring hover:-translate-y-1.5',
              language.hiddenOnMobile && 'hidden md:block',
            ]}
          >
            <Image
              src={language.icon}
              alt=""
              width={50}
              height={50}
              loading="eager"
              class="size-10 sm:size-12.5"
            />
          </button>
        ))
      }
    </div>
  </Card>

  <Card
    class="group relative isolate flex aspect-square flex-col justify-between p-5 sm:px-7 sm:py-8"
    data-enter
    style="--delay: 4"
  >
    <EnvelopeSimpleIcon
      class="absolute -right-5 -bottom-5 -z-10 hidden size-28 -rotate-12 text-zinc-200 transition duration-700 ease-spring group-hover:-translate-y-2 group-hover:-rotate-3 group-has-data-copied:translate-x-24 group-has-data-copied:-translate-y-24 group-has-data-copied:rotate-12 group-has-data-copied:opacity-0 sm:block dark:text-zinc-800"
      aria-hidden="true"
    />
    <span class="text-2xl tracking-tight">Question?</span>
    <CopyEmailButton email={site.email} />
  </Card>

  <Card
    href="https://whisp.gideontigelaar.com/"
    target="_blank"
    rel="noopener noreferrer"
    class="relative aspect-square"
    data-tilt
    data-enter
    style="--delay: 5"
  >
    <Image
      src={whispLogo}
      alt="Whisp"
      loading="eager"
      widths={[250, 500]}
      sizes="(min-width: 640px) 215px, calc(50vw - 30px)"
      class="size-full object-cover"
    />
  </Card>

  <Card
    class="col-span-2 flex flex-col gap-4 p-5 md:flex-row md:items-center md:justify-between md:gap-1 md:px-7 md:py-8"
    data-enter
    style="--delay: 6"
  >
    <div class="contents md:flex md:h-full md:flex-col md:justify-between">
      <div class="flex items-center gap-3 md:w-60">
        <button
          type="button"
          aria-label="Instagram"
          class="shrink-0 rounded-xl transition-transform duration-500 ease-spring hover:scale-115 hover:-rotate-12"
          data-instagram-logo
        >
          <Image src={instagramIcon} alt="" loading="eager" width={35} height={35} />
        </button>
        <span class="text-base text-muted">{site.socials.instagram.label}</span>
      </div>
      <Button href={site.socials.instagram.url} target="_blank" rel="noopener noreferrer" class="order-3">
        Follow me!
      </Button>
    </div>

    <div class="order-2 grid grid-cols-4 gap-2 md:grid-cols-2 md:gap-3">
      {
        photos.map((photo, i) => (
          <button
            type="button"
            aria-label={`Open photo: ${photo.alt}`}
            class:list={[
              'relative aspect-square overflow-hidden rounded-xl transition duration-500 ease-spring hover:z-10 hover:scale-110 hover:shadow-lg',
              scatter[i],
            ]}
            data-gallery-open="photos"
          >
            <Picture
              src={photo.src}
              alt={photo.alt}
              formats={['avif']}
              fallbackFormat="webp"
              width={256}
              widths={[96, 160, 256]}
              sizes="(min-width: 768px) 64px, (min-width: 640px) 96px, calc(25vw - 24px)"
              loading="eager"
              pictureAttributes={{ class: 'contents' }}
              class="size-full object-cover"
            />
          </button>
        ))
      }
    </div>
  </Card>
</section>

<Gallery name="photos" label="Photos" count={slides.length} class="max-w-3xl">
  {
    slides.map(({ src, alt, ratio }) => (
      <div class="grid place-items-center">
        <Picture
          src={src}
          alt={alt}
          formats={['avif']}
          fallbackFormat="webp"
          width={photoWidth}
          widths={[480, 720, 960, 1200, photoWidth]}
          sizes={`min(${galleryWidth}px, 100vw - 2rem, ${ratio * 75}vh)`}
          pictureAttributes={{ class: 'contents' }}
          class="rounded-2xl"
          style={{ width: `min(100%, ${ratio * 75}svh)` }}
          data-gallery-item
        />
      </div>
    ))
  }
</Gallery>

<script>
  import { found } from '../../scripts/eggs';
  import { playOnce, reducedMotion, spring } from '../../scripts/motion';

  const maxTilt = 10;

  document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || reducedMotion.matches) return;
      const { left, top, width, height } = card.getBoundingClientRect();
      const x = (event.clientX - left) / width;
      const y = (event.clientY - top) / height;
      card.style.setProperty('--tilt-x', `${(0.5 - y) * maxTilt}deg`);
      card.style.setProperty('--tilt-y', `${(x - 0.5) * maxTilt}deg`);
    });

    card.addEventListener('pointerleave', () => {
      card.style.removeProperty('--tilt-x');
      card.style.removeProperty('--tilt-y');
    });
  });

  const languageButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-language]')];
  const secret = ['C#', 'C++', 'PHP', 'Java'];
  const comboStep = 900;
  let progress = 0;
  let lastPress = 0;
  let lastTrick = -1;

  const tricks: [PropertyIndexedKeyframes, KeyframeAnimationOptions][] = [
    [
      {
        transform: ['scale(1) rotate(0deg)', 'scale(1.35) rotate(-15deg)', 'scale(1) rotate(360deg)'],
        offset: [0, 0.3, 1],
      },
      { duration: 600, easing: spring },
    ],
    [
      { transform: ['perspective(300px) rotateY(0deg)', 'perspective(300px) rotateY(360deg)'] },
      { duration: 700, easing: spring },
    ],
    [
      { transform: ['perspective(300px) rotateX(0deg)', 'perspective(300px) rotateX(360deg)'] },
      { duration: 700, easing: spring },
    ],
    [
      {
        transform: [
          'translateY(0) scale(1, 1)',
          'translateY(-1.25rem) scale(0.9, 1.15)',
          'translateY(0) scale(1.2, 0.8)',
          'translateY(0) scale(1, 1)',
        ],
        offset: [0, 0.4, 0.75, 1],
      },
      { duration: 650, easing: 'ease-out' },
    ],
    [
      { transform: ['rotate(0deg)', 'rotate(-18deg)', 'rotate(14deg)', 'rotate(-10deg)', 'rotate(6deg)', 'rotate(0deg)'] },
      { duration: 700, easing: 'ease-in-out' },
    ],
    [
      { transform: ['scale(1)', 'scale(1.6)', 'scale(0.85)', 'scale(1.15)', 'scale(1)'] },
      { duration: 600, easing: 'ease-out' },
    ],
  ];

  const shown = () => languageButtons.filter((button) => button.offsetParent !== null);

  const ripple = (source: HTMLButtonElement) => {
    const row = shown();
    const origin = row.indexOf(source);
    row.forEach((button, index) => {
      if (button === source) return;
      button.animate(
        { translate: ['0 0', '0 -0.5rem', '0 0'] },
        { duration: 450, delay: Math.abs(index - origin) * 70, easing: spring, composite: 'add' },
      );
    });
  };

  const celebrate = () => {
    found('language-combo');
    if (reducedMotion.matches) return;
    shown().forEach((button, index) =>
      button.animate(
        {
          transform: ['scale(1) rotate(0deg)', 'scale(1.3) rotate(180deg)', 'scale(1) rotate(360deg)'],
          offset: [0, 0.5, 1],
        },
        { duration: 800, delay: index * 90, easing: spring },
      ),
    );
  };

  languageButtons.forEach((button) => {
    let playing: Animation | undefined;

    button.addEventListener('click', () => {
      const now = performance.now();
      if (now - lastPress > comboStep) progress = 0;
      lastPress = now;

      if (button.dataset.language === secret[progress]) {
        progress += 1;
      } else {
        progress = button.dataset.language === secret[0] ? 1 : 0;
      }

      if (progress === secret.length) {
        progress = 0;
        celebrate();
        return;
      }

      if (reducedMotion.matches || playing?.playState === 'running') return;

      let next = Math.floor(Math.random() * tricks.length);
      if (next === lastTrick) next = (next + 1) % tricks.length;
      lastTrick = next;

      const [keyframes, options] = tricks[next];
      playing = button.animate(keyframes, options);
      ripple(button);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-instagram-logo]').forEach((logo) => {
    logo.addEventListener('click', () =>
      playOnce(
        logo,
        {
          transform: ['rotate(0deg) scale(1)', 'rotate(-20deg) scale(1.3)', 'rotate(360deg) scale(1)'],
          offset: [0, 0.3, 1],
        },
        { duration: 700, easing: spring },
      ),
    );
  });
</script>