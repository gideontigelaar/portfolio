<script>
  import { site } from '../../data/site';
  import { consoleText } from '../../data/text';
  import { found, isDesktop } from '../../scripts/eggs';

  const title = 'font: 700 22px/1.5 system-ui, sans-serif; color: #3b82f6';
  const text = 'font: 500 13px/1.6 system-ui, sans-serif; color: #71717a';
  const label = 'font: 700 13px/1.6 system-ui, sans-serif; color: inherit';

  if (isDesktop()) {
    console.log(`%c${consoleText.greeting}\n%c${consoleText.hint}`, title, text);

    window.hireGideon = () => {
      console.log(
        [
          `%c${site.name}`,
          `%c${consoleText.role}`,
          '',
          ...consoleText.details.map((detail) => `%c${detail.label.padEnd(10)}%c${detail.value}`),
        ].join('\n'),
        title,
        text,
        ...consoleText.details.flatMap(() => [label, text]),
      );
      found('console');
      return consoleText.thanks;
    };
  }
</script>