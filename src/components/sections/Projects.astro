---
import Carousel from '../ui/Carousel.astro';
import Gallery from '../ui/Gallery.astro';
import ProjectCard from '../projects/ProjectCard.astro';
import ProjectDetail from '../projects/ProjectDetail.astro';
import { projects } from '../../data/projects';
import { paginate } from '../../lib/paginate';

const maxProjectsPerPage = 3;
const pages = paginate(projects, maxProjectsPerPage);
---

<section id="projects" class="py-14 sm:py-20">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight" data-reveal>Projects</h2>
  <p class="mb-6 text-muted" data-reveal style="--delay: 1">Here are some of the projects I've worked on.</p>

  <Carousel label="Projects" count={pages.length}>
    {
      pages.map((page, pageIndex) => (
        <div class="grid grid-cols-1 gap-6 sm:gap-2">
          {page.map((project, i) => (
            <div
              data-carousel-item
              data-reveal={pageIndex === 0 || undefined}
              style={pageIndex === 0 ? `--delay: ${i + 2}` : undefined}
            >
              <ProjectCard {...project} />
            </div>
          ))}
        </div>
      ))
    }
  </Carousel>

  <Gallery name="projects" label="Projects" count={projects.length} crossfade class="max-w-lg">
    {projects.map((project) => <ProjectDetail {...project} />)}
  </Gallery>
</section>