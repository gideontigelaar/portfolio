---
import CaretLeftIcon from '@phosphor-icons/core/assets/regular/caret-left.svg';
import CaretRightIcon from '@phosphor-icons/core/assets/regular/caret-right.svg';
import XIcon from '@phosphor-icons/core/assets/regular/x.svg';

interface Props {
  name: string;
  label: string;
  count: number;
  crossfade?: boolean;
  class?: string;
}

const { name, label, count, crossfade = false, class: className } = Astro.props;

const navigation = [
  { icon: CaretLeftIcon, label: 'Previous', direction: -1, position: '-left-16', nudge: 'group-hover:-translate-x-0.5' },
  { icon: CaretRightIcon, label: 'Next', direction: 1, position: '-right-16', nudge: 'group-hover:translate-x-0.5' },
];
---

<dialog
  id={`${name}-gallery`}
  aria-label={label}
  tabindex="-1"
  class="isolate m-0 size-full max-h-none max-w-none flex-col items-center justify-center gap-5 overflow-y-auto overscroll-contain bg-transparent p-4 pb-[calc(5.25rem+env(safe-area-inset-bottom))] text-zinc-950 outline-none [--gallery-space:calc(6.25rem+env(safe-area-inset-bottom))] backdrop:bg-transparent open:flex sm:px-18 sm:pb-4 sm:[--gallery-space:3.75rem] dark:text-zinc-50"
  data-gallery={name}
  data-crossfade={crossfade || undefined}
>
  <div class="fixed inset-x-0 -inset-y-1/2 -z-10 bg-zinc-950/50 backdrop-blur-sm backdrop-webkit" data-gallery-backdrop data-gallery-fade></div>
  <div class:list={['relative w-full shrink-0', className]}>
    <div
      class:list={[
        'flex w-full snap-x snap-mandatory gap-6 overflow-x-auto overscroll-x-contain [scrollbar-width:none] *:max-h-[calc(100svh-var(--gallery-space))] *:w-full *:shrink-0 *:snap-center *:snap-always [&::-webkit-scrollbar]:hidden',
        count > 1 && 'cursor-grab active:cursor-grabbing',
      ]}
      data-gallery-track
    >
      <slot />
    </div>
    {
      count > 1 &&
        navigation.map(({ icon: Icon, label, direction, position, nudge }) => (
          <button
            type="button"
            aria-label={label}
            class:list={[
              'group absolute top-1/2 z-10 hidden size-11 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white backdrop-blur-md transition-colors backdrop-webkit hover:bg-white/20 lg:pointer-fine:grid',
              position,
            ]}
            data-gallery-shift={direction}
            data-gallery-fade
            data-press
          >
            <Icon class:list={['size-5 transition-transform duration-300 ease-spring', nudge]} aria-hidden="true" />
          </button>
        ))
    }
  </div>
  <div
    class="fixed inset-x-0 bottom-[max(1rem,env(safe-area-inset-bottom))] z-10 mx-auto flex w-fit items-center gap-3 rounded-full bg-zinc-900/70 p-1 shadow-lg ring-1 ring-white/10 backdrop-blur-md backdrop-saturate-150 backdrop-webkit sm:contents"
    data-gallery-fade
  >
    {
      count > 1 && (
        <div class="flex gap-4 pl-3 sm:pl-0" data-gallery-dots data-gallery-fade>
          {Array.from({ length: count }, (_, i) => (
            <button
              type="button"
              aria-label={`Show ${i + 1} of ${count}`}
              class="relative size-2 rounded-full bg-white/40 transition-[width,background-color] duration-300 after:absolute after:-inset-x-2 after:-inset-y-3 hover:bg-white/70 aria-[current=true]:w-6 aria-[current=true]:bg-white"
            />
          ))}
        </div>
      )
    }
    <button
      type="button"
      aria-label="Close"
      class="group relative grid size-9 place-items-center rounded-full bg-white/15 text-white transition-colors backdrop-webkit after:absolute after:-inset-1 hover:bg-white/25 sm:fixed sm:top-4 sm:right-4 sm:size-10 sm:bg-white/10 sm:backdrop-blur-md sm:hover:bg-white/20"
      data-gallery-close
      data-gallery-fade
      data-press
    >
      <XIcon class="size-4.5 transition-transform duration-300 ease-spring group-hover:rotate-90 sm:size-5" aria-hidden="true" />
    </button>
  </div>
</dialog>

<script>
  import '../../scripts/gallery';
</script>

<style>
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-gallery-track] > :global(*) {
        animation-name: swipe;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: view(inline);
      }
    }
  }

  @keyframes swipe {
    0%,
    100% {
      opacity: 0.4;
      scale: 0.92;
    }

    50% {
      opacity: 1;
      scale: 1;
    }
  }
</style>