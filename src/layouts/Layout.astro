---
import { Font } from 'astro:assets';
import '../styles/global.css';
import ContextMenu from '../components/ContextMenu.astro';
import Cursor from '../components/Cursor.astro';
import Console from '../components/easter-eggs/Console.astro';
import Konami from '../components/easter-eggs/Konami.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.name, description = site.description, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <Font cssVariable="--font-manrope" preload={[{ weight: 500 }, { weight: 700 }]} />
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (theme === 'dark' || (!theme && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body
    id="home"
    class="bg-zinc-50 font-medium text-zinc-950 antialiased select-none dark:bg-zinc-950 dark:text-zinc-50"
  >
    <div class="mx-auto w-full max-w-[700px] px-6 sm:px-3">
      <Navbar />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <ContextMenu />
    <Cursor />
    <Konami />
    <Console />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(({ isIntersecting, boundingClientRect, target }) => {
            if (!isIntersecting && boundingClientRect.top > 0) return;
            target.setAttribute('data-revealed', '');
            observer.unobserve(target);
          });
        },
        { rootMargin: '0px 0px 10% 0px' },
      );

      document.querySelectorAll('[data-reveal]').forEach((element) => observer.observe(element));
    </script>
  </body>
</html>