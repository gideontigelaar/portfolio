---
import CheckIcon from '@phosphor-icons/core/assets/regular/check.svg';
import PaperPlaneTiltIcon from '@phosphor-icons/core/assets/regular/paper-plane-tilt.svg';
import Button from './Button.astro';

interface Props {
  email: string;
}

const { email } = Astro.props;
---

<Button class="group @max-[5.75rem]:gap-0 @max-[5.75rem]:px-2.5" data-copy-email={email}>
  <span class="grid *:col-start-1 *:row-start-1 *:transition *:duration-300 *:ease-smooth @max-[5.75rem]:sr-only">
    <span class="group-data-copied:-translate-y-3 group-data-copied:opacity-0">Email me</span>
    <span class="translate-y-3 opacity-0 group-data-copied:translate-y-0 group-data-copied:opacity-100" role="status"></span>
  </span>
  <span class="grid *:col-start-1 *:row-start-1 *:size-4 *:transition *:duration-300 *:ease-spring @min-[5.75rem]:@max-[7.25rem]:hidden" aria-hidden="true">
    <PaperPlaneTiltIcon class="group-data-copied:translate-x-4 group-data-copied:-translate-y-4 group-data-copied:opacity-0" />
    <CheckIcon class="scale-0 opacity-0 group-data-copied:scale-100 group-data-copied:opacity-100" />
  </span>
</Button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
    const status = button.querySelector<HTMLElement>('[role="status"]')!;
    let timeout = 0;

    button.addEventListener('click', async () => {
      const email = button.dataset.copyEmail ?? '';

      try {
        await navigator.clipboard.writeText(email);
      } catch {
        window.location.href = `mailto:${email}`;
        return;
      }

      status.textContent = 'Copied!';
      button.setAttribute('data-copied', '');
      clearTimeout(timeout);
      timeout = window.setTimeout(() => button.removeAttribute('data-copied'), 2000);
    });
  });
</script>