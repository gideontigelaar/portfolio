---
import Gallery from '../Gallery.astro';
import ProjectCard from '../ProjectCard.astro';
import ProjectDetail from '../ProjectDetail.astro';
import { projects } from '../../data/projects';
---

<section id="projects" class="py-14 sm:py-20">
  <h2 class="mb-3 text-2xl font-semibold tracking-tight">Projects</h2>
  <p class="mb-6 text-muted">Here are some of the projects I've worked on.</p>

  <div class="grid grid-cols-1 gap-6 sm:gap-2">
    {projects.map((project) => <ProjectCard {...project} />)}
  </div>

  <Gallery name="projects" label="Projects" count={projects.length} crossfade class="max-w-lg">
    {projects.map((project) => <ProjectDetail {...project} />)}
  </Gallery>
</section>