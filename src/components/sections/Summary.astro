---
import { Image } from 'astro:assets';
import EnvelopeSimpleIcon from '@phosphor-icons/core/assets/regular/envelope-simple.svg';
import TrophyIcon from '@phosphor-icons/core/assets/fill/trophy-fill.svg';
import Button from '../Button.astro';
import Card from '../Card.astro';
import CopyEmailButton from '../CopyEmailButton.astro';
import Gallery from '../Gallery.astro';

import instagramIcon from '../../assets/icons/skill-icons/instagram.svg';
import whispLogo from '../../assets/images/logos/whisp.webp';

import { languages } from '../../data/languages';
import { photos } from '../../data/photos';
import { site } from '../../data/site';

const scatter = ['hover:-rotate-6', 'hover:rotate-6', 'hover:rotate-3', 'hover:-rotate-3'];
---

<section
  id="summary"
  class="grid grid-cols-2 gap-4 pb-14 sm:grid-cols-3 sm:grid-rows-2 sm:gap-5 sm:pb-20"
>
  <Card
    href={site.socials.github.url}
    target="_blank"
    rel="noopener noreferrer"
    class="col-span-2 flex flex-col justify-between gap-6 p-5 sm:px-7 sm:py-8"
    data-enter
    style="--delay: 3"
  >
    <span class="text-2xl tracking-tight">Languages I use</span>
    <div class="flex justify-between">
      {
        languages.map((language) => (
          <Image
            src={language.icon}
            alt={language.name}
            data-language
            width={50}
            height={50}
            loading="eager"
            class:list={[
              'size-10 transition-transform duration-500 ease-spring hover:-translate-y-1.5 sm:size-12.5',
              language.hiddenOnMobile && 'hidden md:block',
            ]}
          />
        ))
      }
    </div>
  </Card>

  <Card
    class="group relative isolate flex aspect-square flex-col justify-between p-5 sm:px-7 sm:py-8"
    data-enter
    style="--delay: 4"
  >
    <EnvelopeSimpleIcon
      class="absolute -right-5 -bottom-5 -z-10 hidden size-28 -rotate-12 text-zinc-200 transition duration-700 ease-spring group-hover:-translate-y-2 group-hover:-rotate-3 group-has-data-copied:translate-x-24 group-has-data-copied:-translate-y-24 group-has-data-copied:rotate-12 group-has-data-copied:opacity-0 sm:block dark:text-zinc-800"
      aria-hidden="true"
    />
    <span class="text-2xl tracking-tight">Question?</span>
    <CopyEmailButton email={site.email} />
  </Card>

  <Card
    href="https://whisp.gideontigelaar.com/"
    target="_blank"
    rel="noopener noreferrer"
    class="relative aspect-square"
    data-tilt
    data-enter
    style="--delay: 5"
  >
    <Image
      src={whispLogo}
      alt="Whisp"
      loading="eager"
      widths={[250, 500]}
      sizes="(min-width: 640px) 215px, 50vw"
      class="size-full object-cover"
    />
  </Card>

  <Card
    class="col-span-2 flex flex-col gap-4 p-5 md:flex-row md:items-center md:justify-between md:gap-1 md:px-7 md:py-8"
    data-enter
    style="--delay: 6"
  >
    <div class="contents md:flex md:h-full md:flex-col md:justify-between">
      <div class="flex items-center gap-3 md:w-60">
        <Image
          src={instagramIcon}
          alt="Instagram"
          loading="eager"
          width={35}
          height={35}
          class="transition-transform duration-500 ease-spring hover:scale-115 hover:-rotate-12"
        />
        <span class="text-base text-muted">{site.socials.instagram.label}</span>
      </div>
      <Button
        href={site.socials.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="relative order-3"
        data-instagram-follow
      >
        Follow me!
      </Button>
    </div>

    <div class="order-2 grid grid-cols-4 gap-2 md:grid-cols-2 md:gap-3">
      {
        photos.map((photo, i) => (
          <button
            type="button"
            aria-label={`Open photo: ${photo.alt}`}
            class:list={[
              'relative aspect-square overflow-hidden rounded-xl transition duration-500 ease-spring hover:z-10 hover:scale-110 hover:shadow-lg',
              scatter[i],
            ]}
            data-gallery-open="photos"
          >
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[96, 160, 256]}
              sizes="(min-width: 768px) 64px, 22vw"
              loading="eager"
              class="size-full object-cover"
            />
          </button>
        ))
      }
    </div>
  </Card>
</section>

<Gallery name="photos" label="Photos" count={photos.length} class="max-w-3xl">
  {
    photos.map(({ src, alt }) => {
      const width = (75 * src.width) / src.height;

      return (
        <div class="grid place-items-center">
          <Image
            src={src}
            alt={alt}
            widths={[600, 900, 1200, 1500]}
            sizes={`(min-aspect-ratio: ${Math.round(width)}/100) ${Math.round(width)}vh, 100vw`}
            class="rounded-2xl"
            style={{ width: `min(100%, ${width}svh)` }}
            data-gallery-item
          />
        </div>
      );
    })
  }
</Gallery>

<div
  role="status"
  class="fixed right-4 bottom-20 z-70 flex items-center gap-3 rounded-2xl border border-line bg-surface p-3 pr-5 shadow-lg sm:right-6"
  data-achievement
  hidden
>
  <span class="grid size-10 place-items-center rounded-xl bg-amber-400/20 text-amber-500">
    <TrophyIcon class="size-6" aria-hidden="true" />
  </span>
  <span class="flex flex-col leading-tight">
    <span class="text-xs font-semibold tracking-wide text-muted uppercase">Achievement unlocked</span>
    <span class="font-bold">Full-stack whisperer</span>
    <span class="text-sm text-muted">You found a secret combo</span>
  </span>
</div>

<script>
  import { found } from '../../scripts/eggs';
  import { reducedMotion } from '../../scripts/motion';

  const maxTilt = 10;

  document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || reducedMotion.matches) return;
      const { left, top, width, height } = card.getBoundingClientRect();
      const x = (event.clientX - left) / width;
      const y = (event.clientY - top) / height;
      card.style.setProperty('--tilt-x', `${(0.5 - y) * maxTilt}deg`);
      card.style.setProperty('--tilt-y', `${(x - 0.5) * maxTilt}deg`);
    });

    card.addEventListener('pointerleave', () => {
      card.style.removeProperty('--tilt-x');
      card.style.removeProperty('--tilt-y');
    });
  });

  const languageIcons = [...document.querySelectorAll<HTMLImageElement>('[data-language]')];
  const achievement = document.querySelector<HTMLElement>('[data-achievement]')!;
  const secret = ['PHP', 'MySQL', 'PHP', 'Python'];
  const spring = 'cubic-bezier(0.34, 1.56, 0.64, 1)';
  const spinTime = 600;
  const comboStep = 900;
  let progress = 0;
  let pending = 0;
  let showing = false;

  const openLink = (link: HTMLAnchorElement) => window.open(link.href, link.target || '_blank', 'noopener');

  const unlock = async () => {
    found('language-combo');
    if (!reducedMotion.matches) {
      languageIcons.forEach((icon, i) =>
        icon.animate({ translate: ['0 0', '0 -0.75rem', '0 0'] }, { duration: 450, delay: i * 80, easing: spring }),
      );
    }
    if (showing) return;
    showing = true;
    achievement.hidden = false;
    const motion = reducedMotion.matches
      ? { opacity: [0, 1] }
      : { translate: ['calc(100% + 2rem) 0', '0 0'], opacity: [0, 1] };
    try {
      await achievement.animate(motion, { duration: 500, easing: spring }).finished;
      await new Promise((resolve) => window.setTimeout(resolve, 3000));
      await achievement.animate(motion, { duration: 400, direction: 'reverse', easing: 'ease-in', fill: 'forwards' })
        .finished;
    } catch {}
    achievement.getAnimations().forEach((animation) => animation.cancel());
    achievement.hidden = true;
    showing = false;
  };

  languageIcons.forEach((icon) => {
    let spin: Animation | undefined;

    icon.addEventListener('click', (event) => {
      const link = icon.closest('a');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      window.clearTimeout(pending);

      if (icon.alt === secret[progress]) {
        progress += 1;
      } else {
        progress = icon.alt === secret[0] ? 1 : 0;
      }

      if (!reducedMotion.matches && spin?.playState !== 'running') {
        spin = icon.animate(
          {
            transform: ['scale(1) rotate(0deg)', 'scale(1.35) rotate(-15deg)', 'scale(1) rotate(360deg)'],
            offset: [0, 0.3, 1],
          },
          { duration: spinTime, easing: spring },
        );
      }

      if (progress === secret.length) {
        progress = 0;
        unlock();
        return;
      }

      const delay = progress ? comboStep : reducedMotion.matches ? 0 : spinTime;
      pending = window.setTimeout(() => {
        progress = 0;
        openLink(link);
      }, delay);
    });
  });

  const hearts = ['text-pink-500', 'text-fuchsia-500', 'text-orange-400'];

  document.querySelectorAll<HTMLAnchorElement>('[data-instagram-follow]').forEach((button) => {
    button.addEventListener('click', (event) => {
      if (reducedMotion.matches || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();

      for (let i = 0; i < 7; i++) {
        const heart = document.createElement('span');
        const angle = Math.PI + (Math.PI * (i + 0.5)) / 7;
        const distance = 36 + Math.random() * 24;
        heart.textContent = '♥';
        heart.ariaHidden = 'true';
        heart.className = `pointer-events-none absolute top-1/2 left-1/2 text-base ${hearts[i % hearts.length]}`;
        button.append(heart);
        heart
          .animate(
            {
              transform: [
                'translate(-50%, -50%) scale(0.3)',
                `translate(calc(-50% + ${Math.cos(angle) * distance}px), calc(-50% + ${Math.sin(angle) * distance}px)) scale(1.1) rotate(${(Math.random() - 0.5) * 60}deg)`,
              ],
              opacity: [1, 1, 0],
            },
            { duration: 700, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          )
          .finished.then(() => heart.remove());
      }

      button.animate({ scale: [1, 0.88, 1.08, 1] }, { duration: 450, easing: 'ease-out' });
      window.setTimeout(() => window.open(button.href, button.target || '_blank', 'noopener'), 450);
    });
  });
</script>